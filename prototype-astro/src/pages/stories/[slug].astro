---
import StoryReader from '../../components/StoryReader.tsx';
import { client } from '../../../tina/__generated__/client';
import '../../styles/reader.css';

// Alle Story-Dateinamen aus Tina holen -> eine Route pro Story.
export async function getStaticPaths() {
  const conn = await client.queries.storyConnection();
  const edges = conn.data.storyConnection?.edges ?? [];
  return edges.map((e) => ({ params: { slug: e?.node?._sys.filename } }));
}

const { slug } = Astro.params;
const res = await client.queries.story({ relativePath: `${slug}.md` });
const title = res.data.story.title_de ?? 'Story';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} – Prototyp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Mulish:wght@300;400;500;600;700&display=swap"
    />
  </head>
  <body>
    <!-- client:load -> React-Insel laeuft im Browser, useTina liefert Live-Daten -->
    <StoryReader
      client:load
      query={res.query}
      variables={res.variables}
      data={res.data}
    />
    <p style="max-width:720px;margin:0 auto 60px;padding:0 24px;">
      <a href="/" style="color:#a7672f;">← Alle Stories</a>
    </p>
  </body>
</html>
