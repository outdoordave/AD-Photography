---
import { client } from '../../tina/__generated__/client';
import '../styles/reader.css';

const conn = await client.queries.storyConnection();
const stories = (conn.data.storyConnection?.edges ?? [])
  .map((e) => e?.node)
  .filter(Boolean);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Stories – Astro+Tina Prototyp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Mulish:wght@300;400;500;600;700&display=swap"
    />
  </head>
  <body>
    <div class="proto-list">
      <div class="proto-note">
        <strong>Prototyp</strong> – nur Stories. Editor: <code>/admin</code> öffnen,
        eine Story bearbeiten und die Live-Vorschau beobachten. Die echte Website
        (index.html) ist davon völlig unberührt.
      </div>
      <h1>Stories</h1>
      {
        stories.map((s: any) => (
          <a href={`/stories/${s._sys.filename}`}>
            {s.title_de}
            {s.category_de ? ` · ${s.category_de}` : ''}
          </a>
        ))
      }
    </div>
  </body>
</html>
