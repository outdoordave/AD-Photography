---
// BaseLayout (Stufe 1, Schritt 2).
// Globales Design-System aus index.html (Tokens, Reader-Styles) + Fonts.
// Inhalte ab Schritt 3.
// Schriften LOKAL via Fontsource (kein Google-CDN -> DSGVO). Variable Fonts, damit
// Fraunces' Optical-Size-Achse (opsz) erhalten bleibt = exakt gleiches Rendering wie
// die Google-Variante. full(-italic) deckt opsz+wght+Kursiv ab; Mulish nur wght (normal).
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/mulish';
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteAdminBar from '../components/SiteAdminBar.astro';
import appearance from '../data/appearance-settings.json';
import home from '../data/home-settings.json';
import statistik from '../data/statistik.json';
interface Props {
  title?: string;
  lang?: 'de' | 'en';
  noindex?: boolean;
  preloadImage?: string; // LCP-Bild (z. B. Hero) vorab laden -> startet den Fetch beim HTML-Parsen
}
const { title = 'Wide & Wild', lang = 'de', noindex = false, preloadImage } = Astro.props;
// VORSCHAU-noindex (env-gesteuert, NICHT statisch): greift nur, wenn die Build-Env-Var
// PUBLIC_PREVIEW_NOINDEX === 'true' gesetzt ist. Diese Var wird AUSSCHLIESSLICH im
// Vorschau-Cloudflare-Projekt gesetzt -> die spaetere Live-Seite (anderes Projekt / Var
// NICHT gesetzt) indexiert ganz normal. => Beim Cutover muss NICHTS aus dem Code entfernt
// werden; die Live-Seite kann hierdurch nicht versehentlich deindexiert werden.
const previewNoindex = import.meta.env.PUBLIC_PREVIEW_NOINDEX === 'true';
// Cookielose Web-Analyse: nur einbinden, wenn im CMS aktiviert UND ein Code hinterlegt ist.
const st = statistik as any;
const analyticsSnippet = st.enabled === true && st.analytics_snippet ? String(st.analytics_snippet) : '';
const ap = appearance as any;
const hm = home as any;
const logo = ap.logo || '';
const showStories = ap.show_stories === true;
const showContact = ap.show_contact !== false;
const showAdminBar = ap.show_admin_bar === true;
// TEIL 6: globaler Bild-Rahmen & Schatten (none|soft|strong), Standard soft.
const imageFrame = ['none', 'soft', 'strong'].includes(ap.image_frame) ? ap.image_frame : 'soft';
// Buttons/Eingabefelder mit rahmen? (Standard an)
const frameControls = ap.frame_controls !== false;
// Portfolio-Alben beim Hovern anheben? (Standard an)
const albumHover = ap.album_hover !== false;
const pathname = Astro.url.pathname;
const footerSocial = (hm.intro && hm.intro.social) || [];
const showFooterSocial = !!(hm.social_show && hm.social_show.footer);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    {(noindex || previewNoindex) && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    {analyticsSnippet && <Fragment set:html={analyticsSnippet} />}
    {/* Fonts werden LOKAL via Fontsource gebündelt (Imports im Frontmatter) — KEINE
        Google-Fonts-Links mehr (DSGVO: keine Besucher-IP an Google). */}
  </head>
  <body class={`ww-frame-${imageFrame}${frameControls ? ' ww-frame-controls' : ''}${albumHover ? ' ww-album-hover' : ''}`}>
    {showAdminBar && <SiteAdminBar />}
    <SiteNav lang={lang} pathname={pathname} logo={logo} showStories={showStories} showContact={showContact} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} logo={logo} showStories={showStories} showContact={showContact} social={footerSocial} showSocial={showFooterSocial} />
    {/* Nach-oben-Button (global). Erscheint erst nach Scrollen; sanftes Hochscrollen, respektiert reduced-motion. */}
    <button id="wwToTop" class="ww-totop" type="button" aria-label="Nach oben scrollen" title="Nach oben">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 14 L12 8 L18 14" /></svg>
    </button>
    <script>
      const wwToTop = document.getElementById('wwToTop');
      if (wwToTop) {
        const onScroll = () => { wwToTop.classList.toggle('is-visible', window.scrollY > 400); };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        wwToTop.addEventListener('click', () => {
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        });
      }
    </script>
  </body>
</html>
