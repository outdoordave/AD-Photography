---
// BaseLayout (Stufe 1, Schritt 2).
// Globales Design-System aus index.html (Tokens, Reader-Styles) + Fonts.
// Inhalte ab Schritt 3.
// Schriften LOKAL via Fontsource (kein Google-CDN -> DSGVO). Variable Fonts, damit
// Fraunces' Optical-Size-Achse (opsz) erhalten bleibt = exakt gleiches Rendering wie
// die Google-Variante. full(-italic) deckt opsz+wght+Kursiv ab; Mulish nur wght (normal).
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/mulish';
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteAdminBar from '../components/SiteAdminBar.astro';
import appearance from '../data/appearance-settings.json';
import home from '../data/home-settings.json';
import { normalizePath } from '../lib/stories';
import statistik from '../data/statistik.json';
import contact from '../data/contact.json';
import about from '../data/about.json';
interface Props {
  title?: string;
  lang?: 'de' | 'en';
  noindex?: boolean;
  preloadImage?: string; // LCP-Bild (z. B. Hero) vorab laden -> startet den Fetch beim HTML-Parsen
  description?: string;            // Meta-Description; Default = Marken-Satz (sprachabhängig)
  ogType?: 'website' | 'article';  // 'article' für Story-Detailseiten, sonst 'website'
  jsonld?: Record<string, any> | Record<string, any>[]; // zusätzliche JSON-LD-Knoten (z. B. Article)
}
const { title = 'Wide & Wild', lang = 'de', noindex = false, preloadImage,
        description, ogType = 'website', jsonld } = Astro.props;
// VORSCHAU-noindex (env-gesteuert, NICHT statisch): greift nur, wenn die Build-Env-Var
// PUBLIC_PREVIEW_NOINDEX === 'true' gesetzt ist. Diese Var wird AUSSCHLIESSLICH im
// Vorschau-Cloudflare-Projekt gesetzt -> die spaetere Live-Seite (anderes Projekt / Var
// NICHT gesetzt) indexiert ganz normal. => Beim Cutover muss NICHTS aus dem Code entfernt
// werden; die Live-Seite kann hierdurch nicht versehentlich deindexiert werden.
const previewNoindex = import.meta.env.PUBLIC_PREVIEW_NOINDEX === 'true';
// Cookielose Web-Analyse: nur einbinden, wenn im CMS aktiviert UND ein Code hinterlegt ist.
const st = statistik as any;
const analyticsSnippet = st.enabled === true && st.analytics_snippet ? String(st.analytics_snippet) : '';
const ap = appearance as any;
const hm = home as any;
const logo = ap.logo || '';
const showStories = ap.show_stories === true;
const showContact = ap.show_contact !== false;
const showAdminBar = ap.show_admin_bar === true;
// TEIL 6: globaler Bild-Rahmen & Schatten (none|soft|strong), Standard soft.
const imageFrame = ['none', 'soft', 'strong'].includes(ap.image_frame) ? ap.image_frame : 'soft';
// Buttons/Eingabefelder mit rahmen? (Standard an)
const frameControls = ap.frame_controls !== false;
// Portfolio-Alben beim Hovern anheben? (Standard an)
const albumHover = ap.album_hover !== false;
// Über-uns-Profile beim Hovern anheben? (Schalter auf der „Über uns"-Seite; Standard an)
const personHover = (about as any).person_hover !== false;
const pathname = Astro.url.pathname;
const footerSocial = (hm.intro && hm.intro.social) || [];
const showFooterSocial = !!(hm.social_show && hm.social_show.footer);

// --- SEO/Head (Charge 1, reine Template-Ebene) ---
const metaDescription = description || (lang === 'en'
  ? 'Travel & outdoor photography by Alexandra & David — road trips, wild landscapes and the stories behind the images.'
  : 'Reise- & Outdoor-Fotografie von Alexandra & David — Roadtrips, wilde Landschaften und die Geschichten hinter den Bildern.');
const site = Astro.site; // kanonische Produktions-URL aus astro.config (site)
// Sprachneutraler Pfad wie im Sprachumschalter (SiteNav) -> DE/EN-Pendant je Seite.
const trimmed = pathname.replace(/\/+$/, '') || '/';
const bare = lang === 'en' ? (trimmed.replace(/^\/en/, '') || '/') : trimmed;
const dePath = bare === '/' ? '/' : bare + '/';
const enPath = bare === '/' ? '/en/' : '/en' + bare + '/';
const selfPath = lang === 'en' ? enPath : dePath;
const abs = (p: string) => (site ? new URL(p, site).href : p);
const canonicalURL = abs(selfPath);
const deAltURL = abs(dePath);
const enAltURL = abs(enPath);
// OG-/Twitter-Bild = Startseiten-Hero (EINE Quelle, zieht automatisch mit): Einzelbild,
// sonst erstes Diashow-Bild, sonst Fallback IMG_5904. Gleiche normalizePath-Logik wie im <img>.
const heroData = (hm.hero || {}) as any;
const heroFirstSlide = (Array.isArray(heroData.slideshow) && heroData.slideshow[0])
  ? (typeof heroData.slideshow[0] === 'string' ? heroData.slideshow[0] : heroData.slideshow[0]?.img)
  : '';
const ogImageURL = abs(normalizePath(heroData.image || heroFirstSlide || '/uploads/IMG_5904.webp'));
const ogLocale = lang === 'en' ? 'en_US' : 'de_DE';
// canonical/hreflang nur auf indexierbaren Seiten (nicht 404/Statistik/Vorschau).
const indexable = !(noindex || previewNoindex);

// --- JSON-LD (strukturierte Daten, reine Template-Ebene, kein Tina-Re-Index) ---
// Global: WebSite + Organization „Wide & Wild". Nur real existierende Felder.
// sameAs = Instagram-Profile aus contact.json; logo aus appearance-settings.
const orgId = abs('/') + '#org';
const websiteId = abs('/') + '#website';
const instagramUrls = (((contact as any).channels) || [])
  .filter((c: any) => c && c.type === 'instagram' && c.url)
  .map((c: any) => String(c.url));
const logoURL = logo ? abs(normalizePath(logo)) : '';
const orgNode: Record<string, any> = {
  '@type': 'Organization', '@id': orgId, name: 'Wide & Wild', url: abs('/'),
  ...(logoURL ? { logo: logoURL } : {}),
  ...(instagramUrls.length ? { sameAs: instagramUrls } : {}),
};
const websiteNode: Record<string, any> = {
  '@type': 'WebSite', '@id': websiteId, name: 'Wide & Wild', url: abs('/'),
  inLanguage: lang === 'en' ? 'en' : 'de', publisher: { '@id': orgId },
};
const extraLd = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
const jsonLdGraph = [websiteNode, orgNode, ...extraLd];
// </script> in Inhalten neutralisieren, damit das Skript nicht vorzeitig schließt.
const jsonLdString = JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLdGraph }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Google Search Console — Eigentumsnachweis (URL-Praefix-Property) */}
    <meta name="google-site-verification" content="lVzNiS--1jG5SYBZbBpth1GnR6Rv79zWGawdonfd1Kg" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    {(noindex || previewNoindex) && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    {indexable && <link rel="canonical" href={canonicalURL} />}
    {indexable && <link rel="alternate" hreflang="de" href={deAltURL} />}
    {indexable && <link rel="alternate" hreflang="en" href={enAltURL} />}
    {indexable && <link rel="alternate" hreflang="x-default" href={deAltURL} />}
    {/* Open Graph / Twitter — og:image = Startseiten-Hero (automatisch, eine Quelle, kein eigenes Feld) */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Wide & Wild" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageURL} />
    {/* Strukturierte Daten (JSON-LD): WebSite + Organization global, ggf. Article je Seite */}
    <script type="application/ld+json" set:html={jsonLdString} />
    {analyticsSnippet && <Fragment set:html={analyticsSnippet} />}
    {/* Fonts werden LOKAL via Fontsource gebündelt (Imports im Frontmatter) — KEINE
        Google-Fonts-Links mehr (DSGVO: keine Besucher-IP an Google). */}
  </head>
  <body class={`ww-frame-${imageFrame}${frameControls ? ' ww-frame-controls' : ''}${albumHover ? ' ww-album-hover' : ''}${personHover ? ' ww-person-hover' : ''}`}>
    {showAdminBar && <SiteAdminBar />}
    <SiteNav lang={lang} pathname={pathname} logo={logo} showStories={showStories} showContact={showContact} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} logo={logo} showStories={showStories} showContact={showContact} social={footerSocial} showSocial={showFooterSocial} />
    {/* Nach-oben-Button (global). Erscheint erst nach Scrollen; sanftes Hochscrollen, respektiert reduced-motion. */}
    <button id="wwToTop" class="ww-totop" type="button" aria-label="Nach oben scrollen" title="Nach oben">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 14 L12 8 L18 14" /></svg>
    </button>
    <script>
      const wwToTop = document.getElementById('wwToTop');
      if (wwToTop) {
        const onScroll = () => { wwToTop.classList.toggle('is-visible', window.scrollY > 400); };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        wwToTop.addEventListener('click', () => {
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        });
      }
    </script>
  </body>
</html>
