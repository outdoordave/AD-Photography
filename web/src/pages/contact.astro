---
// Kontakt DE ('/contact'). Daten via Tina-Client (Live-Vorschau); Render in der
// ContactContent-Insel. Wrapper #page-contact für die Live-CSS-Scopes.
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactContent from '../components/ContactContent.tsx';
import { client } from '../../tina/__generated__/client';

const res = await client.queries.kontakt({ relativePath: 'contact.json' });
const title = (res.data.kontakt as any)?.title?.de || 'Kontakt';
---
<BaseLayout title={`${title} — Wide & Wild`} lang="de">
  <div id="page-contact">
    <ContactContent
      client:load
      query={res.query}
      variables={res.variables}
      data={res.data}
      lang="de"
    />
  </div>
</BaseLayout>
