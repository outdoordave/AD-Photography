---
// Journal-Archiv DE ('/journal'). Kopf (Kicker/Titel/Intro) editierbar via SettingsHeader;
// Liste als useTina-Insel (bearbeitbar in der CMS-Vorschau). Listen-Stil aus journal_settings.
import BaseLayout from '../../layouts/BaseLayout.astro';
import JournalArchive from '../../components/JournalArchive.tsx';
import EditorialPageHero from '../../components/editorial/EditorialPageHero.tsx';
import { client } from '../../../tina/__generated__/client';
import appearance from '../../data/appearance-settings.json';
import settings from '../../data/journal-settings.json';
import { sortJournalNodes, journalFirstPhoto } from '../../lib/journal';
import '../../styles/journal.css';

// Journal komplett abschaltbar (🎨 Darstellung → „Journal zeigen?"). Aus = auch Direktaufruf sperren.
if ((appearance as any).show_journal !== true) return Astro.redirect('/');

const res = await client.queries.journalConnection();
const setRes = await client.queries.journal_settings({ relativePath: 'journal-settings.json' });
const s = settings as any;
const design = (appearance as any).design === 'editorial' ? 'editorial' : 'klassisch';

// Editorial-Hero: Titelbild = erstes Foto des neuesten Eintrags (echte Daten).
const edNodes = design === 'editorial'
  ? sortJournalNodes((res.data.journalConnection?.edges || []).map((e: any) => e?.node).filter((n: any) => n && n.archived !== true))
  : [];
const edHeroImg = edNodes.map((n: any) => journalFirstPhoto(n)).find(Boolean) || '';
---
<BaseLayout title={`${s.title_de || 'Journal'} — Wide & Wild`} lang="de" description={s.intro_de || 'Journal — kurze Notizen zwischen den Reisen von Alexandra & David.'}>
  {design === 'editorial' ? (
    <Fragment>
      <EditorialPageHero client:load query={setRes.query} variables={setRes.variables} data={setRes.data} docKey="journal_settings" lang="de" img={edHeroImg} titleFallback="Journal" />
      <JournalArchive client:load
        query={res.query} variables={res.variables} data={res.data}
        setQuery={setRes.query} setVariables={setRes.variables} setData={setRes.data}
        lang="de" prefix="" design="editorial" />
    </Fragment>
  ) : (
    <section>
      <div class="wrap journal-archive">
        <JournalArchive client:load
          query={res.query} variables={res.variables} data={res.data}
          setQuery={setRes.query} setVariables={setRes.variables} setData={setRes.data}
          lang="de" prefix="" />
      </div>
    </section>
  )}
</BaseLayout>
