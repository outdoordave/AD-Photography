---
// Journal-Archiv DE ('/journal'). Liste als useTina-Insel (bearbeitbar in der CMS-Vorschau:
// Klick auf einen Eintrag -> dessen Feld; links die Eintrags-Auswahl). Text vollständig inline,
// Medien nur als kleines Symbol; volle Größe/Interaktivität erst auf der Detailseite.
import BaseLayout from '../../layouts/BaseLayout.astro';
import JournalArchive from '../../components/JournalArchive.tsx';
import { client } from '../../../tina/__generated__/client';
import appearance from '../../data/appearance-settings.json';
import '../../styles/journal.css';

// Journal komplett abschaltbar (🎨 Darstellung → „Journal zeigen?"). Aus = auch Direktaufruf sperren.
if ((appearance as any).show_journal !== true) return Astro.redirect('/');

const res = await client.queries.journalConnection();
---
<BaseLayout title="Journal — Wide & Wild" lang="de" description="Journal — kurze Notizen zwischen den Reisen von Alexandra & David.">
  <section>
    <div class="wrap journal-archive">
      <div class="journal-archive-head">
        <h1>Journal</h1>
        <p class="journal-archive-sub">Kurze Notizen zwischen den großen Reisen.</p>
      </div>
      <JournalArchive client:load query={res.query} variables={res.variables} data={res.data} lang="de" prefix="" />
    </div>
  </section>
</BaseLayout>
