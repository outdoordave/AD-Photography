---
// Statistik DE ('/statistik'). Versteckte Auswerte-Seite (noindex, nicht im Menü).
// Zugang: CMS-Vorschau (📊 Statistik) oder direkte URL. Bettet das Dashboard ein.
import BaseLayout from '../layouts/BaseLayout.astro';
import StatsContent from '../components/StatsContent.tsx';
import { client } from '../../tina/__generated__/client';

const res = await client.queries.statistik({ relativePath: 'statistik.json' });
---
<BaseLayout title="Statistik — Wide & Wild" lang="de" noindex={true}>
  <div id="page-stats">
    <StatsContent client:load query={res.query} variables={res.variables} data={res.data} lang="de" />
  </div>
</BaseLayout>
