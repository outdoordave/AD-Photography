---
// Reisen DE ('/trips'). Reisen via Tina-Client (reisenConnection) -> Live-Vorschau-
// fähig in der TripsContent-Insel (useTina + data-tina-field). Seitentexte +
// Karten-Stil weiter aus trips-settings.json. Tab-Vorauswahl per ?trip=<slug>.
import BaseLayout from '../layouts/BaseLayout.astro';
import TripsContent from '../components/TripsContent.tsx';
import { tl } from '../lib/trips';
import settings from '../data/trips-settings.json';
import { client } from '../../tina/__generated__/client';

const res = await client.queries.reisenConnection({ first: 100 });
const s = settings as any;
const mapStyle = s.map_style || 'liberty';
---
<BaseLayout title={`${tl(s.title, 'de') || 'Reisen'} — Wide & Wild`} lang="de">
  <section>
    <div class="wrap">
      <div class="page-title">
        <div class="kicker">{tl(s.kicker, 'de')}</div>
        <h1>{tl(s.title, 'de')}</h1>
        <p>{tl(s.intro, 'de')}</p>
      </div>
      <TripsContent
        client:load
        query={res.query}
        variables={res.variables}
        data={res.data}
        lang="de"
        mapStyle={mapStyle}
      />
    </div>
  </section>
</BaseLayout>
