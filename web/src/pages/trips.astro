---
// Reisen DE ('/trips'). Reisen via Tina-Client (reisenConnection) -> Live-Vorschau-
// fähig in der TripsContent-Insel (useTina + data-tina-field). Seitentexte +
// Karten-Stil weiter aus trips-settings.json. Tab-Vorauswahl per ?trip=<slug>.
import BaseLayout from '../layouts/BaseLayout.astro';
import TripsContent from '../components/TripsContent.tsx';
import SettingsHeader from '../components/SettingsHeader.tsx';
import { tl } from '../lib/trips';
import { linkedAlbumsByTrip } from '../lib/albums';
import settings from '../data/trips-settings.json';
import { client } from '../../tina/__generated__/client';

const res = await client.queries.reisenConnection({ first: 100 });
const albRes = await client.queries.albenConnection({ first: 1000 });
const setRes = await client.queries.reisen_settings({ relativePath: 'trips-settings.json' });
const linkedAlbums = linkedAlbumsByTrip(albRes.data);
const s = settings as any;
const mapStyle = s.map_style || 'liberty';
const mapScrollZoom = s.map_scroll_zoom !== false; // Standard AN
---
<BaseLayout title={`${s.title_de || 'Reisen'} — Wide & Wild`} lang="de">
  <section>
    <div class="wrap">
      <SettingsHeader client:load query={setRes.query} variables={setRes.variables} data={setRes.data} docKey="reisen_settings" lang="de" />
      <TripsContent
        client:load
        query={res.query}
        variables={res.variables}
        data={res.data}
        lang="de"
        mapStyle={mapStyle}
        scrollZoom={mapScrollZoom}
        linkedAlbums={linkedAlbums}
      />
    </div>
  </section>
</BaseLayout>
