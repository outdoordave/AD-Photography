---
// Reisen DE ('/trips'). Stufe 5a: Reisen statisch aus src/data/trips/ geladen +
// in der TripsContent-Insel gerendert. (Tina-Anbindung folgt in Stufe 5b/5c.)
import BaseLayout from '../layouts/BaseLayout.astro';
import TripsContent from '../components/TripsContent.tsx';
import { sortTrips, type RawTrip } from '../lib/trips';

const modules = import.meta.glob('../data/trips/*.json', { eager: true });
const raw = Object.entries(modules).map(([path, mod]) => ({
  slug: path.split('/').pop()!.replace('.json', ''),
  data: ((mod as any).default || mod) as RawTrip,
}));
const trips = sortTrips(raw);
const mapStyle = 'liberty';
---
<BaseLayout title="Unsere Roadtrips — Wide & Wild" lang="de">
  <section>
    <div class="wrap">
      <div class="page-title">
        <div class="kicker">Reisen</div>
        <h1>Unsere Roadtrips</h1>
        <p>Tausende Kilometer, unzählige Stopps. Tippe auf eine Station, um zu sehen, was wir dort erlebt haben.</p>
      </div>
      <TripsContent client:load trips={trips} lang="de" mapStyle={mapStyle} />
    </div>
  </section>
</BaseLayout>
