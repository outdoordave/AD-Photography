---
// Reisen DE ('/trips'). Reisen statisch aus src/data/trips/ (via Tina-Collection
// „🧭 Reisen" editierbar); Seitentexte + Karten-Stil aus trips-settings.json.
import BaseLayout from '../layouts/BaseLayout.astro';
import TripsContent from '../components/TripsContent.tsx';
import { sortTrips, tl, type RawTrip } from '../lib/trips';
import settings from '../data/trips-settings.json';

const modules = import.meta.glob('../data/trips/*.json', { eager: true });
const raw = Object.entries(modules).map(([path, mod]) => ({
  slug: path.split('/').pop()!.replace('.json', ''),
  data: ((mod as any).default || mod) as RawTrip,
}));
const trips = sortTrips(raw);
const s = settings as any;
const mapStyle = s.map_style || 'liberty';
---
<BaseLayout title={`${tl(s.title, 'de') || 'Reisen'} — Wide & Wild`} lang="de">
  <section>
    <div class="wrap">
      <div class="page-title">
        <div class="kicker">{tl(s.kicker, 'de')}</div>
        <h1>{tl(s.title, 'de')}</h1>
        <p>{tl(s.intro, 'de')}</p>
      </div>
      <TripsContent client:load trips={trips} lang="de" mapStyle={mapStyle} />
    </div>
  </section>
</BaseLayout>
