---
// Album subpage EN ('/en/portfolio/<slug>'). Same album, English labels.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AlbumContent from '../../../components/AlbumContent.tsx';
import AdminDocTools from '../../../components/AdminDocTools.tsx';
import { client } from '../../../../tina/__generated__/client';

export async function getStaticPaths() {
  const conn = await client.queries.albenConnection({ first: 1000 });
  const edges = (conn.data.albenConnection?.edges || []).filter(Boolean);
  return edges.map((e: any) => ({ params: { slug: e.node._sys.filename } }));
}

const { slug } = Astro.params;
const res = await client.queries.alben({ relativePath: `${slug}.json` });
const data = res.data.alben as any;
const name = (data?.name_en || data?.name) || 'Album';
const archived = data?.archived === true;
// Meta-Description aus der Album-Notiz (EN, sonst DE), Fallback templatisiert.
const metaDesc = (data?.note_en || data?.note_de || `Photo album “${name}” by Wide & Wild.`).replace(/\s+/g, ' ').trim().slice(0, 200);
---
<BaseLayout title={`${name} — Wide & Wild`} lang="en" description={metaDesc} noindex={archived}>
  <AdminDocTools client:load collection="alben" relativePath={`${slug}.json`} title={name} variant="bar" />
  <section>
    <div class="wrap">
      <AlbumContent client:load query={res.query} variables={res.variables} data={res.data} lang="en" />
    </div>
  </section>
</BaseLayout>
