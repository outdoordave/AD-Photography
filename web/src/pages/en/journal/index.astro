---
// Journal archive EN ('/en/journal'). Mirror of the DE archive — list as a useTina island.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JournalArchive from '../../../components/JournalArchive.tsx';
import { client } from '../../../../tina/__generated__/client';
import appearance from '../../../data/appearance-settings.json';
import '../../../styles/journal.css';

if ((appearance as any).show_journal !== true) return Astro.redirect('/en/');

const res = await client.queries.journalConnection();
---
<BaseLayout title="Journal — Wide & Wild" lang="en" description="Journal — short notes between the trips by Alexandra & David.">
  <section>
    <div class="wrap journal-archive">
      <div class="journal-archive-head">
        <h1>Journal</h1>
        <p class="journal-archive-sub">Short notes between the big trips.</p>
      </div>
      <JournalArchive client:load query={res.query} variables={res.variables} data={res.data} lang="en" prefix="/en" />
    </div>
  </section>
</BaseLayout>
