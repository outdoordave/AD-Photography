---
// Journal archive EN ('/en/journal'). Mirror of the DE archive.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RichText from '../../../components/RichText';
import { client } from '../../../../tina/__generated__/client';
import { socialIcon } from '../../../lib/socialIcons';
import {
  sortJournalNodes, journalHeading, journalHasTitle, formatFullDate, journalText,
  journalFirstPhoto, parseGeoPoint, resolveLinkedContent, resolveSocial, journalLink,
} from '../../../lib/journal';
import appearance from '../../../data/appearance-settings.json';
import '../../../styles/journal.css';

if ((appearance as any).show_journal !== true) return Astro.redirect('/en/');

const conn = await client.queries.journalConnection();
const nodes = sortJournalNodes((conn.data.journalConnection?.edges ?? []).map((e: any) => e?.node).filter(Boolean) as any[]);
const lang = 'en' as const;
---
<BaseLayout title="Journal — Wide & Wild" lang="en" description="Journal — short notes between the trips by Alexandra & David.">
  <section>
    <div class="wrap journal-archive">
      <div class="journal-archive-head">
        <h1>Journal</h1>
        <p class="journal-archive-sub">Short notes between the big trips.</p>
      </div>
      {nodes.length === 0 ? (
        <p class="journal-empty">No entries yet.</p>
      ) : (
        <ol class="journal-list">
          {nodes.map((j: any) => {
            const slug = j._sys.filename;
            const heading = journalHeading(j, lang);
            const hasTitle = journalHasTitle(j, lang);
            const dateLabel = formatFullDate(j.date || '', lang);
            const text = journalText(j, lang);
            const photo = journalFirstPhoto(j);
            const point = parseGeoPoint(j.location);
            const linked = resolveLinkedContent(j, lang);
            const social = resolveSocial(j, lang);
            const extLink = journalLink(j, lang);
            return (
              <li class="journal-item">
                <a class="journal-item-head" href={`/en/journal/${slug}`}>
                  <span class="ji-title">{heading}</span>
                  {hasTitle ? <span class="ji-date">{dateLabel}</span> : null}
                </a>
                {text ? <div class="journal-item-text ww-rich"><RichText value={text} /></div> : null}
                {(photo || point || social || linked || j.youtube_url || extLink) ? (
                  <div class="journal-item-media">
                    {photo ? <a class="jm-thumb" href={`/en/journal/${slug}`}><img src={photo} alt="" loading="lazy" /></a> : null}
                    {point ? <span class="jm-badge" title="Location" aria-label="Location">📍</span> : null}
                    {social ? <span class="jm-badge jm-social" title={social.platform} aria-label={social.platform} set:html={socialIcon(social.platform)} /> : null}
                    {linked ? <span class="jm-badge jm-linked">{linked.typeLabel}</span> : null}
                    {j.youtube_url ? <span class="jm-badge" title="Video" aria-label="Video">▶</span> : null}
                    {extLink ? <span class="jm-badge" title="Link" aria-label="Link">↗</span> : null}
                  </div>
                ) : null}
              </li>
            );
          })}
        </ol>
      )}
    </div>
  </section>
</BaseLayout>
