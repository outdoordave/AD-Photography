---
// Stories list EN ('/en/stories'). Moved from '/en/' since '/' is the real homepage.
// Editorial-Weiche 1:1 wie DE ('/stories'), nur EN-Felder/-Labels + /en-Links.
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StoryCard from '../../../components/StoryCard.astro';
import AdminDocTools from '../../../components/AdminDocTools.tsx';
import AdminSectionBar from '../../../components/AdminSectionBar.astro';
import SettingsHeader from '../../../components/SettingsHeader.tsx';
import EditorialPageHero from '../../../components/editorial/EditorialPageHero.tsx';
import { toSortedStories, normalizePath } from '../../../lib/stories';
import { groupByYear } from '../../../lib/groupByYear';
import { tl } from '../../../lib/albums';
import settings from '../../../data/stories-settings.json';
import appearance from '../../../data/appearance-settings.json';
import { client } from '../../../../tina/__generated__/client';

// Stories für Besucher ausgeblendet? (Schalter 🎨 Darstellung → „Stories zeigen?", Standard aus).
// Nav-/Footer-Link werden schon ausgeblendet; hier zusätzlich den Direktaufruf von /en/stories
// sperren. Logik = wie Nav/Footer (sichtbar NUR bei show_stories === true).
if ((appearance as any).show_stories !== true) return Astro.redirect('/en/');

// Archived posts are hidden from visitors (kept in CMS + repo, restorable).
const allEntries = await getCollection('stories');
const entries = allEntries.filter((e) => (e.data as any).archived !== true);
const stories = toSortedStories(entries.map((e) => ({ slug: e.slug, data: e.data })));
const archivedItems = allEntries.filter((e) => (e.data as any).archived === true)
  .map((e) => ({ relativePath: `${e.slug}.md`, title: (e.data as any).title_en || (e.data as any).title_de || e.slug, date: (e.data as any).date || '', teaser: (e.data as any).excerpt_en || (e.data as any).excerpt_de || '', href: `/en/stories/${e.slug}` }));
const setRes = await client.queries.stories_settings({ relativePath: 'stories-settings.json' });
const s = settings as any;
const design = (appearance as any).design === 'editorial' ? 'editorial' : 'klassisch';

// --- Editorial: alternierende Bild/Text-Reihen (wie DE) aus echten Stories, EN-Texte ---
const edStories = design === 'editorial' ? stories.map((st, i) => ({
  href: `/en/stories/${st.slug}`,
  src: normalizePath(st.photo),
  alt: st.en.title,
  meta: st.en.dateLabel,
  title: st.en.title,
  teaser: st.en.excerpt,
  cols: i % 2 === 0 ? '7fr 5fr' : '5fr 7fr',
  imgOrder: i % 2 === 0 ? 0 : 2,
})) : [];
const edHeroImg = edStories[0]?.src || '';
const yearFirst = stories.length ? String(stories[stories.length - 1].date || '').slice(0, 4) : '';
const yearLast = stories.length ? String(stories[0].date || '').slice(0, 4) : '';
const edRange = yearFirst && yearLast ? (yearFirst === yearLast ? yearFirst : `${yearFirst} — ${yearLast}`) : '';
---
<BaseLayout title={`${s.title_en || s.title_de || 'Stories from the road'} — Wide & Wild`} lang="en" description="Stories from the road — travel reports and photo essays by Alexandra & David.">
  {design === 'editorial' ? (
    <Fragment>
      <EditorialPageHero client:load query={setRes.query} variables={setRes.variables} data={setRes.data} docKey="stories_settings" lang="en" img={edHeroImg} titleFallback="Stories" />
      <div class="wrap" style="padding-top:24px;"><AdminSectionBar collection="story" newLabel="New story" archived={archivedItems} lang="en" /></div>
      <section class="ed-section" style="padding-top:clamp(80px,12vw,120px);padding-bottom:0">
        <div class="ed-section-head" data-reveal>
          <span class="ed-index">All stories</span>
          <span class="ed-rule"></span>
          {edRange && <span class="ed-more">{edRange}</span>}
        </div>
        <div class="ed-sfeat-list">
          {edStories.map((st) => (
            <a href={st.href} class="ed-sfeat" data-reveal style={`grid-template-columns:${st.cols}`}>
              <span class="ed-sfeat-img" style={`order:${st.imgOrder}`}>
                {st.src && <img src={st.src} alt={st.alt} data-zoom loading="lazy" decoding="async" />}
              </span>
              <span class="ed-sfeat-body">
                <span class="ed-sfeat-meta">{st.meta}</span>
                <span class="ed-sfeat-title">{st.title}</span>
                {st.teaser && <span class="ed-sfeat-teaser">{st.teaser}</span>}
                <span class="ed-sfeat-link">Read the story →</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  ) : (
    <section>
      <div class="wrap">
        <SettingsHeader client:load query={setRes.query} variables={setRes.variables} data={setRes.data} docKey="stories_settings" lang="en" />
        <AdminSectionBar collection="story" newLabel="New story" archived={archivedItems} lang="en" />
        {groupByYear(stories, (s) => s.date).map((g) => (
          <div class="year-chapter">
            <h2 class="year-head">{g.isArchive ? 'Archive' : g.year}</h2>
            <div class="stories-grid">
              {g.items.map((s) => (
                <div class="ww-card-wrap">
                  <StoryCard story={s} lang="en" base="/en" />
                  <AdminDocTools client:load collection="story" relativePath={`${s.slug}.md`} title={s.en.title} />
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
