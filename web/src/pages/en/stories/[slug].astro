---
// Story reader EN ('/en/stories/<slug>'). Editable fields as a small React island
// (Tina live preview); reader-nav stays Astro. English fields.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StoryReaderContent from '../../../components/StoryReaderContent.tsx';
import AdminDocTools from '../../../components/AdminDocTools.tsx';
import { client } from '../../../../tina/__generated__/client';
import { buildStory, normalizePath } from '../../../lib/stories';
import appearance from '../../../data/appearance-settings.json';

export async function getStaticPaths() {
  const conn = await client.queries.storyConnection();
  const nodes = (conn.data.storyConnection?.edges ?? []).map((e: any) => e?.node).filter(Boolean);
  const sorted = [...nodes].sort((a: any, b: any) => (b.date || '').localeCompare(a.date || ''));
  return sorted.map((node: any, i: number) => {
    const prevNode = sorted[i - 1] ?? null;
    const nextNode = sorted[i + 1] ?? null;
    return {
      params: { slug: node._sys.filename },
      props: {
        prev: prevNode ? { slug: prevNode._sys.filename, title: buildStory(prevNode).en.title } : null,
        next: nextNode ? { slug: nextNode._sys.filename, title: buildStory(nextNode).en.title } : null,
      },
    };
  });
}

const { slug } = Astro.params;
const { prev, next } = Astro.props as {
  prev: { slug: string; title: string } | null;
  next: { slug: string; title: string } | null;
};
// Stories ausgeblendet? Dann auch Einzelbeitrag /en/stories/<slug> nicht direkt zeigen.
if ((appearance as any).show_stories !== true) return Astro.redirect('/en/');
const res = await client.queries.story({ relativePath: `${slug}.md` });
const story = buildStory(res.data.story as any);
const design = (appearance as any).design === 'editorial' ? 'editorial' : 'klassisch';
// Editorial: „Weiterführend"-Karten aus verknüpftem Album (falls vorhanden).
const linkedAlbum = (res.data.story as any)?.linked_album;
const edAlbumSlug = linkedAlbum?._sys?.filename || '';
// Archived -> page still built (edit/restore), but noindex (out of search).
const archived = (res.data.story as any)?.archived === true;
const title = story.en.title;
// Meta-Description aus dem Story-Anriss (EN, sonst DE), Fallback templatisiert. og:type article.
const metaDesc = (story.en.excerpt || `“${title}” — a travel story by Wide & Wild.`).replace(/\s+/g, ' ').trim().slice(0, 200);
// JSON-LD Article — nur real existierende Felder. author/publisher = Organization „Wide & Wild"
// (per @id, global im BaseLayout definiert). Kein Tina-Re-Index.
const site = Astro.site;
const abs = (p: string) => (site ? new URL(p, site).href : p);
const canonical = abs(`/en/stories/${slug}/`);
const orgRef = { '@id': abs('/') + '#org' };
const articleLd: Record<string, any> = {
  '@type': 'Article',
  headline: title,
  ...(story.en.excerpt ? { description: metaDesc } : {}),
  ...(story.date ? { datePublished: story.date } : {}),
  ...(story.photo ? { image: abs(normalizePath(story.photo)) } : {}),
  inLanguage: 'en',
  mainEntityOfPage: canonical,
  author: orgRef,
  publisher: orgRef,
};
---
<BaseLayout title={`${title} — Wide & Wild`} lang="en" description={metaDesc} ogType="article" jsonld={articleLd} noindex={archived}>
  {design === 'editorial' ? (
    <div id="page-story">
      <a class="ed-reader-back" href="/en/stories">← Stories</a>
      <AdminDocTools client:load collection="story" relativePath={`${slug}.md`} title={title} variant="bar" />
      <StoryReaderContent client:load query={res.query} variables={res.variables} data={res.data} lang="en" design="editorial" />
      <section class="ed-related">
        <div class="ed-related-grid">
          {edAlbumSlug && (
            <a class="ed-related-card" href={`/en/portfolio/${edAlbumSlug}`}>
              <span class="ed-related-k">The album</span>
              <span class="ed-related-t">All photos from the trip →</span>
            </a>
          )}
          <a class="ed-related-card" href="/en/stories">
            <span class="ed-related-k">More</span>
            <span class="ed-related-t">More stories →</span>
          </a>
          {next && (
            <a class="ed-related-card" href={`/en/stories/${next.slug}`}>
              <span class="ed-related-k">Next story</span>
              <span class="ed-related-t">{next.title} →</span>
            </a>
          )}
        </div>
      </section>
    </div>
  ) : (
  <div id="page-story">
    <a class="story-back" href="/en/stories">← Stories</a>
    <AdminDocTools client:load collection="story" relativePath={`${slug}.md`} title={title} variant="bar" />
    <StoryReaderContent
      client:load
      query={res.query}
      variables={res.variables}
      data={res.data}
      lang="en"
    />

    <div class="reader-nav">
      {prev ? (
        <a href={`/en/stories/${prev.slug}`}><span class="dir">← Previous</span>{prev.title}</a>
      ) : (
        <button disabled><span class="dir">← Previous</span>—</button>
      )}
      {next ? (
        <a class="next" href={`/en/stories/${next.slug}`}><span class="dir">Next →</span>{next.title}</a>
      ) : (
        <button class="next" disabled><span class="dir">Next →</span>—</button>
      )}
    </div>
  </div>
  )}
</BaseLayout>
