---
// Story reader EN ('/en/stories/<slug>'). Same markup as DE, English fields.
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { toSortedStories, wwYouTubeEmbed, normalizePath, type StoryViewWithSlug } from '../../../lib/stories';

export async function getStaticPaths() {
  const entries = await getCollection('stories');
  const stories = toSortedStories(entries.map((e) => ({ slug: e.slug, data: e.data })));
  return stories.map((s, i) => ({
    params: { slug: s.slug },
    props: {
      story: s,
      prev: stories[i - 1] ?? null,
      next: stories[i + 1] ?? null,
    },
  }));
}

interface Props {
  story: StoryViewWithSlug;
  prev: StoryViewWithSlug | null;
  next: StoryViewWithSlug | null;
}
const { story, prev, next } = Astro.props;
const d = story.en;
const cover = story.photo ? normalizePath(story.photo) : '';
const ytHtml = wwYouTubeEmbed(story.youtube);
---
<BaseLayout title={`${d.title} — Wide & Wild`} lang="en">
  <div id="page-story">
    <div class="reader-hero">
      {cover ? (
        <img class="reader-cover-img" src={cover} alt="" />
      ) : (
        <div class="ph" style="--ph-c1:#8a9a7e; --ph-c2:#3a4a38;"></div>
      )}
      <div class="reader-hero-inner">
        <div class="meta">{d.cat}</div>
        <h1>{d.title}</h1>
      </div>
    </div>

    <div class="reader-body">
      <Fragment set:html={d.bodyHtml} />
      <Fragment set:html={ytHtml} />
    </div>

    <div class="reader-nav">
      {prev ? (
        <a href={`/en/stories/${prev.slug}`}><span class="dir">← Previous</span>{prev.en.title}</a>
      ) : (
        <button disabled><span class="dir">← Previous</span>—</button>
      )}
      {next ? (
        <a class="next" href={`/en/stories/${next.slug}`}><span class="dir">Next →</span>{next.en.title}</a>
      ) : (
        <button class="next" disabled><span class="dir">Next →</span>—</button>
      )}
    </div>
  </div>
</BaseLayout>
