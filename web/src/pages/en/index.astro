---
// Homepage EN ('/en/'). Hero + Intro + Moments + Latest + Discover (stage 2+3).
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeHero from '../../components/HomeHero.astro';
import HomeIntro from '../../components/HomeIntro.astro';
import HomeMoments from '../../components/HomeMoments.tsx';
import HomeLatest from '../../components/HomeLatest.astro';
import HomeDiscover from '../../components/HomeDiscover.tsx';
import { bi } from '../../lib/albums';
import { buildMoments, buildLatest, buildDiscover } from '../../lib/home';
import home from '../../data/home-settings.json';
import appearance from '../../data/appearance-settings.json';
import highlights from '../../data/highlights.json';

const h = home as any;
const ap = appearance as any;
const showStories = ap.show_stories === true;
const showDiscover = ap.show_discover !== false;
const lang = 'en';

const albumMods = import.meta.glob('../../data/albums/*.json', { eager: true });
const albums = Object.entries(albumMods).map(([p, m]) => ({ slug: p.split('/').pop()!.replace('.json', ''), data: ((m as any).default || m) }));
const tripMods = import.meta.glob('../../data/trips/*.json', { eager: true });
const trips = Object.entries(tripMods).map(([p, m]) => ({ slug: p.split('/').pop()!.replace('.json', ''), data: ((m as any).default || m) }));
const storyEntries = await getCollection('stories');
const stories = storyEntries.map((e) => ({ slug: e.slug, data: e.data }));

const hlImages = (highlights as any).images || [];
const moments = buildMoments(albums, hlImages, lang);
const latest = buildLatest({ stories, trips, albums, lang, showStories, prefix: '/en' });
const discover = buildDiscover({ albums, trips, highlights: hlImages, lang, prefix: '/en' });

const s = h.sections || {};
const intro = h.intro || {};
const socialShow = h.social_show || {};
const socialList = intro.social || [];
---
<BaseLayout title="Wide & Wild — Travel & Outdoor Photography" lang="en">
  <HomeHero hero={h.hero} logo={ap.logo} showHeroLogo={ap.show_hero_logo !== false} showStories={showStories} lang="en" social={socialList} showSocial={socialShow.hero === true} />

  <HomeIntro subline={bi(intro, 'subline', lang)} subtext={bi(intro, 'subtext', lang)} social={socialList} showSocial={socialShow.intro !== false} />

  {moments.length > 0 && (
    <section style="padding-top:0;">
      <div class="wrap">
        <div class="section-head" style="text-align:center; margin-left:auto; margin-right:auto;">
          <div class="kicker">{bi(s, 'gallery_kicker', lang)}</div>
          <h2>{bi(s, 'gallery_title', lang)}</h2>
        </div>
        <HomeMoments client:load moments={moments} lang="en" />
      </div>
    </section>
  )}

  {latest.length > 0 && (
    <section style="padding-top:0;">
      <div class="wrap">
        <div class="section-head" style="text-align:center; margin-left:auto; margin-right:auto;">
          <div class="kicker">{bi(s, 'latest_kicker', lang)}</div>
          <h2>{bi(s, 'latest_title', lang)}</h2>
        </div>
        <HomeLatest cards={latest} />
      </div>
    </section>
  )}

  {showDiscover && discover.length > 0 && (
    <section style="padding-top:0;">
      <div class="wrap">
        <div class="section-head" style="text-align:center; margin-left:auto; margin-right:auto;">
          <div class="kicker">{bi(s, 'discover_kicker', lang)}</div>
          <h2>{bi(s, 'discover_title', lang)}</h2>
        </div>
        <HomeDiscover client:load pool={discover} />
      </div>
    </section>
  )}
</BaseLayout>
