---
// Imprint EN ('/en/impressum'). Same Tina-Client data as the DE page.
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalContent from '../../components/LegalContent.tsx';
import { client } from '../../../tina/__generated__/client';

const res = await client.queries.impressum({ relativePath: 'impressum.json' });
const title = (res.data.impressum as any)?.title_en || (res.data.impressum as any)?.title_de || 'Imprint';
---
<BaseLayout title={`${title} — Wide & Wild`} lang="en" description="Legal notice (Impressum) of Wide & Wild — provider identification and contact.">
  <div id="page-legal">
    <LegalContent client:load query={res.query} variables={res.variables} data={res.data} lang="en" docKey="impressum" />
  </div>
</BaseLayout>
