---
// Trips page EN ('/en/trips'). Same data as the DE page, English labels.
import BaseLayout from '../../layouts/BaseLayout.astro';
import TripsContent from '../../components/TripsContent.tsx';
import { sortTrips, type RawTrip } from '../../lib/trips';

const modules = import.meta.glob('../../data/trips/*.json', { eager: true });
const raw = Object.entries(modules).map(([path, mod]) => ({
  slug: path.split('/').pop()!.replace('.json', ''),
  data: ((mod as any).default || mod) as RawTrip,
}));
const trips = sortTrips(raw);
const mapStyle = 'liberty';
---
<BaseLayout title="Our road trips — Wide & Wild" lang="en">
  <section>
    <div class="wrap">
      <div class="page-title">
        <div class="kicker">Trips</div>
        <h1>Our road trips</h1>
        <p>Thousands of miles, countless stops. Tap a station to see what we got up to there.</p>
      </div>
      <TripsContent client:load trips={trips} lang="en" mapStyle={mapStyle} />
    </div>
  </section>
</BaseLayout>
