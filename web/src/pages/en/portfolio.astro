---
// Gallery EN ('/en/portfolio'). Same albums via albenConnection, English labels.
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryContent from '../../components/GalleryContent.tsx';
import SettingsHeader from '../../components/SettingsHeader.tsx';
import AdminNewButton from '../../components/AdminNewButton.astro';
import { tl } from '../../lib/albums';
import settings from '../../data/gallery-settings.json';
import { client } from '../../../tina/__generated__/client';

const res = await client.queries.albenConnection({ first: 1000 });
const setRes = await client.queries.galerie_settings({ relativePath: 'gallery-settings.json' });
const s = settings as any;
const modes = s.modes || { album: true, chronological: false, alphabetical: false };
---
<BaseLayout title={`${s.title_en || s.title_de || 'Portfolio'} — Wide & Wild`} lang="en" description="Selected work by Wide & Wild — landscapes, wildlife and travel moments in photo albums.">
  <section>
    <div class="wrap">
      <SettingsHeader client:load query={setRes.query} variables={setRes.variables} data={setRes.data} docKey="galerie_settings" lang="en" />
      <AdminNewButton collection="alben" label="New album" />
      <GalleryContent
        client:load
        query={res.query}
        variables={res.variables}
        data={res.data}
        lang="en"
        modes={modes}
      />
    </div>
  </section>
</BaseLayout>
