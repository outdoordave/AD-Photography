---
// Gallery EN ('/en/portfolio'). Same albums via albenConnection, English labels.
// Editorial-Weiche 1:1 wie DE ('/portfolio'), nur EN-Felder/-Labels + /en-Links.
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryContent from '../../components/GalleryContent.tsx';
import SettingsHeader from '../../components/SettingsHeader.tsx';
import EditorialPageHero from '../../components/editorial/EditorialPageHero.tsx';
import EditorialAlbumTile from '../../components/editorial/EditorialAlbumTile.tsx';
import AdminSectionBar from '../../components/AdminSectionBar.astro';
import { tl } from '../../lib/albums';
import { photoDisplay } from '../../lib/trips';
import { normalizePath } from '../../lib/stories';
import settings from '../../data/gallery-settings.json';
import appearance from '../../data/appearance-settings.json';
import { client } from '../../../tina/__generated__/client';

const res = await client.queries.albenConnection({ first: 1000 });
const setRes = await client.queries.galerie_settings({ relativePath: 'gallery-settings.json' });
const s = settings as any;
const ap = appearance as any;
const design = ap.design === 'editorial' ? 'editorial' : 'klassisch';

// --- Editorial: Album-Collage (12-Spalten, wie DE) aus echten, nicht-archivierten Alben ---
const SEASON = (m: number) => (m <= 2 || m === 12 ? 'Winter' : m <= 5 ? 'Spring' : m <= 8 ? 'Summer' : 'Fall');
const ALBUM_SPANS = [
  { col: '1 / span 7', row: 'span 6' }, { col: '8 / span 5', row: 'span 6' },
  { col: '1 / span 5', row: 'span 5' }, { col: '6 / span 7', row: 'span 5' },
  { col: '1 / span 7', row: 'span 5' }, { col: '8 / span 5', row: 'span 5' },
];
const albNodes = (res.data.albenConnection?.edges || []).filter(Boolean).map((e: any) => e.node).filter((n: any) => n && !n.archived);
const edAlbums = design === 'editorial' ? albNodes.map((n: any, i: number) => {
  const photos = (Array.isArray(n.photos) ? n.photos : []).filter((p: any) => typeof p === 'string' && p).slice(0, 6).map((p: any) => normalizePath(photoDisplay(p)));
  const d = String(n.date || ''); const mm = parseInt(d.slice(5, 7), 10);
  const meta = d ? (d.slice(0, 4) + (mm ? ' · ' + SEASON(mm) : '')) : (n.note_en || n.note_de || '');
  const sp = ALBUM_SPANS[i % ALBUM_SPANS.length];
  return { title: n.name_en || n.name || n._sys.filename, meta, photos, href: `/en/portfolio/${n._sys.filename}`, col: sp.col, row: sp.row };
}).sort((a: any, b: any) => 0) : [];
const edHeroImg = edAlbums[0]?.photos?.[0] || '';
const modes = s.modes || { album: true, chronological: false, alphabetical: false };
// Archivierte Alben für das Archiv-Panel (Ausblenden selbst passiert in GalleryContent).
const archivedItems = (res.data.albenConnection?.edges || []).filter(Boolean)
  .filter((e: any) => e.node?.archived === true)
  .map((e: any) => ({ relativePath: `${e.node._sys.filename}.json`, title: e.node.name_en || e.node.name || e.node._sys.filename, date: e.node.date || '', teaser: e.node.note_en || e.node.note_de || '', href: `/en/portfolio/${e.node._sys.filename}` }));
---
<BaseLayout title={`${s.title_en || s.title_de || 'Portfolio'} — Wide & Wild`} lang="en" description="Selected work by Wide & Wild — landscapes, wildlife and travel moments in photo albums.">
  {design === 'editorial' ? (
    <Fragment>
      <EditorialPageHero client:load query={setRes.query} variables={setRes.variables} data={setRes.data} docKey="galerie_settings" lang="en" img={edHeroImg} titleFallback="Albums" />
      <div class="wrap" style="padding-top:24px;"><AdminSectionBar collection="alben" newLabel="New album" archived={archivedItems} lang="en" /></div>
      <section class="ed-section" style="padding-top:clamp(60px,9vw,96px)">
        <div class="ed-collage ed-collage--albums">
          {edAlbums.map((a: any) => (
            <EditorialAlbumTile client:load href={a.href} title={a.title} meta={a.meta} photos={a.photos} col={a.col} row={a.row} />
          ))}
        </div>
      </section>
      <section class="ed-section" style="padding-top:clamp(80px,12vw,120px);padding-bottom:0">
        <div class="ed-section-head" data-reveal>
          <span class="ed-index">Next album</span>
          <span class="ed-rule"></span>
          <span class="ed-more">Alaska &amp; California · Fall 2026</span>
        </div>
      </section>
    </Fragment>
  ) : (
    <section>
      <div class="wrap">
        <SettingsHeader client:load query={setRes.query} variables={setRes.variables} data={setRes.data} docKey="galerie_settings" lang="en" />
        <AdminSectionBar collection="alben" newLabel="New album" archived={archivedItems} lang="en" />
        <GalleryContent client:load query={res.query} variables={res.variables} data={res.data} lang="en" modes={modes} />
      </div>
    </section>
  )}
</BaseLayout>
