---
// Story-Reader DE ('/stories/<slug>'). Editierbare Felder laufen als kleine
// React-Insel (Tina Live-Vorschau); reader-nav bleibt Astro.
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryReaderContent from '../../components/StoryReaderContent.tsx';
import AdminDocTools from '../../components/AdminDocTools.tsx';
import { client } from '../../../tina/__generated__/client';
import { buildStory, normalizePath } from '../../lib/stories';
import appearance from '../../data/appearance-settings.json';

export async function getStaticPaths() {
  const conn = await client.queries.storyConnection();
  const nodes = (conn.data.storyConnection?.edges ?? []).map((e: any) => e?.node).filter(Boolean);
  const sorted = [...nodes].sort((a: any, b: any) => (b.date || '').localeCompare(a.date || ''));
  return sorted.map((node: any, i: number) => {
    const prevNode = sorted[i - 1] ?? null;
    const nextNode = sorted[i + 1] ?? null;
    return {
      params: { slug: node._sys.filename },
      props: {
        prev: prevNode ? { slug: prevNode._sys.filename, title: buildStory(prevNode).de.title } : null,
        next: nextNode ? { slug: nextNode._sys.filename, title: buildStory(nextNode).de.title } : null,
      },
    };
  });
}

const { slug } = Astro.params;
const { prev, next } = Astro.props as {
  prev: { slug: string; title: string } | null;
  next: { slug: string; title: string } | null;
};
// Stories ausgeblendet? Dann auch Einzelbeitrag /stories/<slug> nicht direkt zeigen.
if ((appearance as any).show_stories !== true) return Astro.redirect('/');
const res = await client.queries.story({ relativePath: `${slug}.md` });
const story = buildStory(res.data.story as any);
const design = (appearance as any).design === 'editorial' ? 'editorial' : 'klassisch';
// Editorial: „Weiterführend"-Karten aus verknüpftem Album (falls vorhanden).
const linkedAlbum = (res.data.story as any)?.linked_album;
const edAlbumSlug = linkedAlbum?._sys?.filename || '';
// Archiviert -> Seite bleibt gebaut (Bearbeiten/Zurückholen), aber noindex (raus aus Suche).
const archived = (res.data.story as any)?.archived === true;
const title = story.de.title;
// Meta-Description aus dem Story-Anriss (excerpt), Fallback templatisiert. Story = og:type article.
const metaDesc = (story.de.excerpt || `„${title}“ — eine Reisegeschichte von Wide & Wild.`).replace(/\s+/g, ' ').trim().slice(0, 200);
// JSON-LD Article — nur real existierende Felder (Titel, excerpt, Datum, Cover). author/publisher
// = Organization „Wide & Wild" (per @id, global im BaseLayout definiert). Kein Tina-Re-Index.
const site = Astro.site;
const abs = (p: string) => (site ? new URL(p, site).href : p);
const canonical = abs(`/stories/${slug}/`);
const orgRef = { '@id': abs('/') + '#org' };
const articleLd: Record<string, any> = {
  '@type': 'Article',
  headline: title,
  ...(story.de.excerpt ? { description: metaDesc } : {}),
  ...(story.date ? { datePublished: story.date } : {}),
  ...(story.photo ? { image: abs(normalizePath(story.photo)) } : {}),
  inLanguage: 'de',
  mainEntityOfPage: canonical,
  author: orgRef,
  publisher: orgRef,
};
---
<BaseLayout title={`${title} — Wide & Wild`} lang="de" description={metaDesc} ogType="article" jsonld={articleLd} noindex={archived}>
  {design === 'editorial' ? (
    <div id="page-story">
      <a class="ed-reader-back" href="/stories">← Stories</a>
      <AdminDocTools client:load collection="story" relativePath={`${slug}.md`} title={title} variant="bar" />
      <StoryReaderContent client:load query={res.query} variables={res.variables} data={res.data} lang="de" design="editorial" />
      <section class="ed-related">
        <div class="ed-related-grid">
          {edAlbumSlug && (
            <a class="ed-related-card" href={`/portfolio/${edAlbumSlug}`}>
              <span class="ed-related-k">Das Album</span>
              <span class="ed-related-t">Alle Fotos der Reise →</span>
            </a>
          )}
          <a class="ed-related-card" href="/stories">
            <span class="ed-related-k">Mehr</span>
            <span class="ed-related-t">Weitere Stories →</span>
          </a>
          {next && (
            <a class="ed-related-card" href={`/stories/${next.slug}`}>
              <span class="ed-related-k">Nächste Story</span>
              <span class="ed-related-t">{next.title} →</span>
            </a>
          )}
        </div>
      </section>
    </div>
  ) : (
    <div id="page-story">
      <a class="story-back" href="/stories">← Stories</a>
      <AdminDocTools client:load collection="story" relativePath={`${slug}.md`} title={title} variant="bar" />
      <StoryReaderContent
        client:load
        query={res.query}
        variables={res.variables}
        data={res.data}
        lang="de"
      />

      <div class="reader-nav">
        {prev ? (
          <a href={`/stories/${prev.slug}`}><span class="dir">← Vorherige</span>{prev.title}</a>
        ) : (
          <button disabled><span class="dir">← Vorherige</span>—</button>
        )}
        {next ? (
          <a class="next" href={`/stories/${next.slug}`}><span class="dir">Nächste →</span>{next.title}</a>
        ) : (
          <button class="next" disabled><span class="dir">Nächste →</span>—</button>
        )}
      </div>
    </div>
  )}
</BaseLayout>
