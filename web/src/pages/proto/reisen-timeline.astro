---
// PROTOTYP-Route /proto/reisen-timeline — reine Vorschau der Variante B (vertikale
// Timeline / Reise-Journal). Isoliert: berührt weder die echte Reisen-Seite (/trips)
// noch das Tina-Schema noch echten Content. noindex (soll nicht in Google).
import BaseLayout from '../../layouts/BaseLayout.astro';
import TripsTimelineProto from '../../components/proto/TripsTimelineProto.tsx';
import '../../styles/proto-timeline.css';
---
<BaseLayout title="Prototyp · Reisen-Timeline — Wide & Wild" lang="de" noindex={true}>
  {/* EIN Scroll-Kontext. Das magnetische Andocken übernimmt die Insel per JS (snapToNearest
      beim Ruhen) — zuverlässiger als CSS-scroll-snap, besonders in Safari. */}
  <section style="padding-top:18px;">
    <div class="wrap">
      <TripsTimelineProto client:load lang="de" />
    </div>
  </section>
</BaseLayout>
