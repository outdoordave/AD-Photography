---
// PROTOTYP-Route /proto/reisen-timeline — reine Vorschau der Variante B (vertikale
// Timeline / Reise-Journal). Isoliert: berührt weder die echte Reisen-Seite (/trips)
// noch das Tina-Schema noch echten Content. noindex (soll nicht in Google).
import BaseLayout from '../../layouts/BaseLayout.astro';
import TripsTimelineProto from '../../components/proto/TripsTimelineProto.tsx';
import '../../styles/proto-timeline.css';
---
<BaseLayout title="Prototyp · Reisen-Timeline — Wide & Wild" lang="de" noindex={true}>
  {/* EIN Scroll-Kontext: Snapping auf dem Dokument-Scroller (proximity, nicht mandatory).
      scroll-padding-top = Sticky-Nav + Reise-Kopf (von der Insel als --ww-snap-pad gesetzt) ->
      der Snap-Anker liegt exakt mittig im sichtbaren Timeline-Band (= aktive Station / Balken-Ende).
      Nur auf dieser Proto-Route (Style wird mit der Seite gebündelt). */}
  <style is:global>
    html { scroll-snap-type: y proximity; scroll-padding-top: var(--ww-snap-pad, 200px); }
    @media (prefers-reduced-motion: reduce) { html { scroll-snap-type: none; } }
  </style>
  <section style="padding-top:18px;">
    <div class="wrap">
      <TripsTimelineProto client:load lang="de" />
    </div>
  </section>
</BaseLayout>
