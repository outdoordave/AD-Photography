---
// Equipment-Seite DE ('/gear'). Seitentexte/Kategorien aus gear.json; die Teile aus der
// eigenen `equipment`-Collection (equipmentConnection). GearContent rendert live via useTina.
import BaseLayout from '../layouts/BaseLayout.astro';
import GearContent from '../components/GearContent.tsx';
import EditorialPageHero from '../components/editorial/EditorialPageHero.tsx';
import { client } from '../../tina/__generated__/client';
import appearance from '../data/appearance-settings.json';
import { groupGear } from '../lib/gear';

const res = await client.queries.gear({ relativePath: 'gear.json' });
const eqRes = await client.queries.equipmentConnection({ first: 1000 });
const g = (res.data.gear as any) || {};
const title = g.title_de || 'Equipment';
const design = (appearance as any).design === 'editorial' ? 'editorial' : 'klassisch';

// Teile aus der Collection (nach Reihenfolge-Zahl, dann Name) für die Hero-Sprungpillen.
const eqItems = ((eqRes.data.equipmentConnection?.edges || []).map((e: any) => e?.node).filter(Boolean))
  .sort((a: any, b: any) => ((typeof a.sort === 'number' ? a.sort : 1e9) - (typeof b.sort === 'number' ? b.sort : 1e9)) || String(a.name || '').localeCompare(String(b.name || '')));
const edGroups = design === 'editorial' ? groupGear(eqItems, Array.isArray(g.categories) ? g.categories : []) : [];
const edToc = edGroups.map((grp: any, i: number) => ({ id: grp.id, label: `${String(i + 1).padStart(2, '0')} ${grp.de}` }));
const edHeroImg = '/uploads/img_1418-2.webp';
---
<BaseLayout title={`${title} — Wide & Wild`} lang="de" description="Die Ausrüstung hinter Wide & Wild — Kameras, Objektive, Drohnen und Reise-Gear von Alexandra & David.">
  {design === 'editorial' ? (
    <Fragment>
      <EditorialPageHero client:load query={res.query} variables={res.variables} data={res.data} docKey="gear" lang="de" img={edHeroImg} titleFallback="Equipment">
        {edToc.length > 0 && (
          <div class="ed-hero-toc">
            {edToc.map((tc: any) => (<a class="ed-toc-pill" href={`#${tc.id}`}>{tc.label}</a>))}
          </div>
        )}
      </EditorialPageHero>
      <GearContent client:load query={eqRes.query} variables={eqRes.variables} data={eqRes.data} gearDoc={g} lang="de" design="editorial" />
    </Fragment>
  ) : (
    <section>
      <div class="wrap">
        <GearContent
          client:load
          query={eqRes.query}
          variables={eqRes.variables}
          data={eqRes.data}
          gearDoc={g}
          lang="de"
        />
      </div>
    </section>
  )}
</BaseLayout>
