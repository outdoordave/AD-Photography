---
// Equipment-Seite DE ('/gear'). Daten via Tina-Client (Live-Vorschau-fähig wie
// Stories); Render in der GearContent-Insel. Aufbau wie #page-gear in index.html.
import BaseLayout from '../layouts/BaseLayout.astro';
import GearContent from '../components/GearContent.tsx';
import { client } from '../../tina/__generated__/client';

const res = await client.queries.gear({ relativePath: 'gear.json' });
const title = (res.data.gear as any)?.title_de || 'Equipment';
---
<BaseLayout title={`${title} — Wide & Wild`} lang="de">
  <section>
    <div class="wrap">
      <GearContent
        client:load
        query={res.query}
        variables={res.variables}
        data={res.data}
        lang="de"
      />
    </div>
  </section>
</BaseLayout>
