---
// Reise-DETAILSEITE DE ('/trips/<slug>') — Variante-B-Timeline (TripTimeline-Insel).
// Daten via reisenConnection (useTina) + reisen_settings (Live-Kartenstil/Tuning). Tina-Router
// der reisen-Collection zeigt hierher -> Visual-Editing (Klick=Feld + Live-Update) bleibt.
import BaseLayout from '../../layouts/BaseLayout.astro';
import TripTimeline from '../../components/TripTimeline.tsx';
import EditorialTripV2 from '../../components/EditorialTripV2.tsx';
import AdminDocTools from '../../components/AdminDocTools.tsx';
import { richToPlain } from '../../components/RichText.tsx';
import { linkedAlbumsByTrip } from '../../lib/albums';
import { tripTitle, tripCover, bi, viewStops, type RawTrip } from '../../lib/trips';
import { fallbackImage } from '../../lib/fallback';
import { tripDesignsCss, resolveTripDesign, mergeTuning } from '../../lib/tripDesigns';
import settings from '../../data/trips-settings.json';
import appearance from '../../data/appearance-settings.json';
import { client } from '../../../tina/__generated__/client';
import '../../styles/trips-timeline.css';

export async function getStaticPaths() {
  const conn = await client.queries.reisenConnection({ first: 100 });
  const edges = (conn.data.reisenConnection?.edges || []).filter(Boolean);
  return edges.map((e: any) => ({ params: { slug: e.node._sys.filename } }));
}

const { slug } = Astro.params;
const res = await client.queries.reisenConnection({ first: 100 });
const albRes = await client.queries.albenConnection({ first: 1000 });
const setRes = await client.queries.reisen_settings({ relativePath: 'trips-settings.json' });
const linkedAlbums = linkedAlbumsByTrip(albRes.data);
const s = settings as any;
const mapStyle = s.map_style || 'liberty';
const mapScrollZoom = s.map_scroll_zoom !== false;
const mapAutoPopup = s.map_auto_popup !== false;
// globale Tuning-Werte (Phase 3): Defaults eingefroren, falls (noch) nicht im Schema.
const spotlight = typeof s.spotlight_strength === 'number' ? s.spotlight_strength : 70;
const dimMs = typeof s.dim_fade_ms === 'number' ? s.dim_fade_ms : 800;
const revealMs = typeof s.reveal_ms === 'number' ? s.reveal_ms : 800;
const snap = s.snap_enabled === true;
const node = (res.data.reisenConnection?.edges || []).map((e: any) => e?.node).find((n: any) => n?._sys?.filename === slug);
const trip = (node || {}) as RawTrip;
const archived = (trip as any)?.archived === true;
const ttl = tripTitle(trip, 'de') || (s.title_de || 'Reise');
const customSvg = (trip as any).vehicle_custom_svg;
const vehicleId = (typeof customSvg === 'string' && customSvg.trim().slice(0, 4) === '<svg') ? customSvg : ((trip as any).vehicle || 'expedition');
// Reise-Design (Schritt 1): noch KEIN CMS-Feld -> resolveTripDesign(undefined) = 'strong' (byte-gleich).
// Ab Schritt 2 liest der Guard das echte Feld trip.design. Die 4 Design-Blöcke kommen aus EINER Quelle
// (lib/tripDesigns.ts) als gescopter <style> -> kein Drift zwischen Build und (späterem) Regler-Feld.
// Design ist ZENTRAL (gilt für alle Reisen) -> aus den Reisen-Einstellungen, nicht pro Reise.
const tripDesign = resolveTripDesign((s as any).design);
const tripDesignCss = tripDesignsCss(mergeTuning(s.designs));
// Meta-Description aus vorhandenem Inhalt (Reise-Zusammenfassung), Fallback templatisiert.
const metaDesc = (richToPlain(trip.summary_de) || `Reisebericht „${ttl}“ — Stationen, Karte und Fotos einer Reise von Wide & Wild.`).replace(/\s+/g, ' ').trim().slice(0, 200);

// --- Editorial „v2": Hero + Fakten + Etappen/Karte (EditorialTripV2, Fahrzeug-Engine wie bisher) + Weiterführend ---
const design = (appearance as any).design === 'editorial' ? 'editorial' : 'klassisch';
const SEASON = (m: number) => (m <= 2 || m === 12 ? 'Winter' : m <= 5 ? 'Frühling' : m <= 8 ? 'Sommer' : 'Herbst');
const seasonYear = (d: string) => { const mm = parseInt(String(d).slice(5, 7), 10); const yy = String(d).slice(0, 4); return d ? (mm ? `${SEASON(mm)} ${yy}` : yy) : ''; };
const edStops = design === 'editorial' ? viewStops(trip, 'de') : [];
const edRoute = edStops.map((st: any) => st.name).filter(Boolean).join(' → ');
const edSeason = seasonYear(trip.date || '');
const edMetaTxt = bi(trip, 'meta', 'de');
// Cover-Kette: eigenes/Stop-Foto -> sonst automatisches Fallback-Motiv (je nach Inhalt).
const edCover = tripCover(trip) || (edStops.find((st: any) => st.photo)?.photo || '') || fallbackImage(ttl, edRoute, edMetaTxt, richToPlain(trip.summary_de));
const edMetaLine = [edRoute, edMetaTxt].filter(Boolean).join(' · ');
const edAlbum = linkedAlbums[slug as string];
const mDays = edMetaTxt.match(/(\d+)\s*Tage?/i);
const mKm = edMetaTxt.match(/([\d.\s]+)\s*km/i);
const edFacts = [
  edSeason ? { k: 'Zeitraum', v: edSeason } : null,
  { k: 'Stationen', v: String(edStops.length) },
  mDays ? { k: 'Dauer', v: `${mDays[1]} Tage` } : null,
  mKm ? { k: 'Strecke', v: `${mKm[1].trim()} km` } : null,
].filter(Boolean).slice(0, 4) as { k: string; v: string }[];
---
<BaseLayout title={`${ttl} — Wide & Wild`} lang="de" description={metaDesc} noindex={archived}>
  {design === 'editorial' ? (
    <Fragment>
      <AdminDocTools client:load collection="reisen" relativePath={`${slug}.json`} title={ttl} variant="bar" />
      <header class="ed-reader-hero ed-trip-hero">
        <div class="ed-reader-hero-img" data-ed-hero-img>{edCover && <img src={edCover} alt="" fetchpriority="high" decoding="async" />}</div>
        <div class="ed-reader-hero-scrim" aria-hidden="true"></div>
        <div class="ed-reader-hero-content" data-ed-hero-content>
          <p class="ed-reader-kicker">{['Reise', edSeason].filter(Boolean).join(' · ')}</p>
          <h1 class="ed-reader-title">{ttl}</h1>
          {edMetaLine && <p class="ed-reader-meta">{edMetaLine}</p>}
        </div>
      </header>
      {edFacts.length > 0 && (
        <section class="ed-trip-facts">
          <div class="ed-trip-facts-grid" data-reveal style={`--fact-cols:${edFacts.length}`}>
            {edFacts.map((f) => (<div class="ed-fact"><span class="ed-fact-k">{f.k}</span><span class="ed-fact-v">{f.v}</span></div>))}
          </div>
        </section>
      )}
      {edStops.length > 0 && (
        <section class="ed-route">
          <div class="ed-section-head" data-reveal>
            <span class="ed-index">Die Route</span>
            <span class="ed-rule"></span>
            <span class="ed-more">Karte folgt den Etappen beim Scrollen</span>
          </div>
          <EditorialTripV2 client:load query={res.query} variables={res.variables} data={res.data} lang="de" initialSlug={slug} mapStyle={mapStyle} scrollZoom={mapScrollZoom} />
        </section>
      )}
      <section class="ed-related">
        <div class="ed-related-grid">
          {edAlbum && (<a class="ed-related-card" href={`/portfolio/${edAlbum.slug}`}><span class="ed-related-k">Das Album</span><span class="ed-related-t">Alle Fotos der Reise →</span></a>)}
          <a class="ed-related-card" href="/trips"><span class="ed-related-k">Mehr</span><span class="ed-related-t">Alle Reisen →</span></a>
        </div>
      </section>
    </Fragment>
  ) : (
    <Fragment>
      <Fragment set:html={`<style>${tripDesignCss}</style>`} />
      <AdminDocTools client:load collection="reisen" relativePath={`${slug}.json`} title={ttl} variant="bar" />
      <section style="padding-top:8px;">
        <div class="wrap">
          <TripTimeline
            design={tripDesign}
            client:load
            query={res.query}
            variables={res.variables}
            data={res.data}
            lang="de"
            mapStyle={mapStyle}
            scrollZoom={mapScrollZoom}
            autoPopup={mapAutoPopup}
            initialSlug={slug}
            linkedAlbums={linkedAlbums}
            settingsQuery={setRes.query}
            settingsVariables={setRes.variables}
            settingsData={setRes.data}
            spotlight={spotlight}
            dimMs={dimMs}
            revealMs={revealMs}
            snap={snap}
            vehicleId={vehicleId}
          />
        </div>
      </section>
    </Fragment>
  )}
</BaseLayout>
