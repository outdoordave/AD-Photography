---
// Galerie DE ('/portfolio'). Alben via Tina-Client (albenConnection) -> Live-Vorschau
// in der GalleryContent-Insel. Seitentexte + Sortier-Modi aus gallery-settings.json.
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryContent from '../components/GalleryContent.tsx';
import SettingsHeader from '../components/SettingsHeader.tsx';
import AdminSectionBar from '../components/AdminSectionBar.astro';
import { tl } from '../lib/albums';
import settings from '../data/gallery-settings.json';
import { client } from '../../tina/__generated__/client';

const res = await client.queries.albenConnection({ first: 1000 });
const setRes = await client.queries.galerie_settings({ relativePath: 'gallery-settings.json' });
const s = settings as any;
const modes = s.modes || { album: true, chronological: false, alphabetical: false };
// Archivierte Alben für das Archiv-Panel (Ausblenden selbst passiert in GalleryContent).
const archivedItems = (res.data.albenConnection?.edges || []).filter(Boolean)
  .filter((e: any) => e.node?.archived === true)
  .map((e: any) => ({ relativePath: `${e.node._sys.filename}.json`, title: e.node.name || e.node._sys.filename, date: e.node.date || '', teaser: e.node.note_de || '', href: `/portfolio/${e.node._sys.filename}` }));
---
<BaseLayout title={`${s.title_de || 'Portfolio'} — Wide & Wild`} lang="de" description="Ausgewählte Aufnahmen von Wide & Wild — Landschaften, Wildlife und Reisemomente in Foto-Alben.">
  <section>
    <div class="wrap">
      <SettingsHeader client:load query={setRes.query} variables={setRes.variables} data={setRes.data} docKey="galerie_settings" lang="de" />
      <AdminSectionBar collection="alben" newLabel="Neues Album" archived={archivedItems} lang="de" />
      <GalleryContent
        client:load
        query={res.query}
        variables={res.variables}
        data={res.data}
        lang="de"
        modes={modes}
      />
    </div>
  </section>
</BaseLayout>
