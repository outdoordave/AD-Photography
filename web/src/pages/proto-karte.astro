---
// PROTOTYP-Seite (isoliert): MapLibre-Karte + Stationen-Durchwischen.
// Beweist die zwei groessten Unbekannten vor dem Reisen-Vollausbau.
// Echte Reise als Datengrundlage (content/trips/west.json -> src/data/trip-proto.json).
import BaseLayout from '../layouts/BaseLayout.astro';
import TripMapProto, { type ProtoStop } from '../components/TripMapProto.tsx';
import tripData from '../data/trip-proto.json';

// Koordinaten extrahieren wie pickStopCoord (1557): location-GeoJSON zuerst.
function coord(s: any): { lon: number; lat: number } | null {
  if (typeof s.location === 'string' && s.location.indexOf('coordinates') !== -1) {
    try {
      const g = JSON.parse(s.location);
      const c = g && g.coordinates;
      if (Array.isArray(c) && typeof c[0] === 'number' && typeof c[1] === 'number') return { lon: c[0], lat: c[1] };
    } catch {}
  }
  if (typeof s.lat === 'number' && typeof s.lon === 'number') return { lon: s.lon, lat: s.lat };
  return null;
}

const stops: ProtoStop[] = (tripData.stops || [])
  .map((s: any) => {
    const c = coord(s);
    if (!c) return null;
    return {
      name: s.name || '',
      lon: c.lon,
      lat: c.lat,
      title: s.title_de || s.name || '',
      text: s.text_de || '',
      date: s.date_de || '',
    };
  })
  .filter(Boolean) as ProtoStop[];
---
<BaseLayout title="Prototyp · Karte + Wischen — Wide & Wild">
  <section>
    <div class="wrap">
      <div class="page-title">
        <div class="kicker">Prototyp (isoliert)</div>
        <h1>{tripData.title_de}</h1>
        <p>MapLibre-Karte + Stationen-Durchwischen — 1:1-Test gegen die Live-Seite. {stops.length} echte Stationen.</p>
      </div>
      <TripMapProto client:load stops={stops} />
      <p style="color:var(--c-ink-soft); font-size:var(--fs-ui); margin-top:18px; text-align:center;">
        Durch die Stationen wischen (oder Pfeile) → die Karte fliegt zur Station. Marker anklicken → Bahn springt hin.
      </p>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* --- Karten-/Stationen-CSS 1:1 aus index.html (nur fuer den Prototyp) --- */
  .map-layout { display: grid; grid-template-columns: 1.5fr 1fr; gap: 30px; align-items: start; }
  .map-box { border-radius: var(--radius-sm); overflow: hidden; position: relative; height: 420px; }
  .map-box .maplibregl-map { height: 100%; border-radius: var(--radius-sm); }

  /* MapLibre-Popup im Website-Stil */
  .maplibregl-popup-content { background: var(--c-dark); color: var(--c-dark-ink); border-radius: var(--radius-sm); box-shadow: 0 4px 16px rgba(0,0,0,.4); border: none; padding: 10px 14px; font-family: var(--font-body); }
  .maplibregl-popup-tip { border-top-color: var(--c-dark) !important; border-bottom-color: var(--c-dark) !important; }
  .ww-popup-name { font-size: var(--fs-ui); font-weight: var(--fw-bold); color: #f0c9a8; margin: 0 0 2px; }
  .ww-popup-date { font-size: var(--fs-label); color: #9a8c76; margin: 0; }

  /* Stationen-Snap-Bahn */
  .trip-detail {
    background: var(--c-bg-alt); border: 1px solid var(--c-line); border-radius: var(--radius-sm);
    min-height: 320px; position: relative;
    display: flex; overflow-x: auto; overflow-y: hidden;
    scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch; scrollbar-width: none;
  }
  .trip-detail::-webkit-scrollbar { display: none; }
  .trip-slide { flex: 0 0 100%; box-sizing: border-box; padding: 28px; scroll-snap-align: center; }
  .trip-detail .step { font-size: var(--fs-label); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--c-accent); font-weight: var(--fw-bold); margin-bottom: 8px; }
  .trip-detail h3 { font-family: var(--font-display); font-size: var(--fs-title-lg); font-weight: var(--fw-medium); margin-bottom: 8px; }
  .trip-detail .date { font-size: var(--fs-label); color: var(--c-ink-soft); margin-bottom: 16px; }
  .trip-detail p { color: #4a3d2c; line-height: 1.7; }

  /* Pfeil-Overlay ausserhalb der mitwischenden Slides */
  .trip-detail-wrap { position: relative; min-width: 0; overflow: hidden; }
  .stop-arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 10;
    width: 34px; height: 34px; cursor: pointer;
    border: none; background: transparent; color: #fff;
    text-shadow: 0 1px 3px rgba(0,0,0,.6), 0 0 2px rgba(0,0,0,.55);
    font-size: var(--fs-title-lg); line-height: 1; display: flex; align-items: center; justify-content: center;
    padding-bottom: 3px; transition: opacity var(--dur-base) var(--ease);
  }
  .stop-arrow-prev { left: 8px; }
  .stop-arrow-next { right: 8px; }
  .stop-arrow::before { content: ""; position: absolute; inset: -5px; }
  .stop-arrow:hover { opacity: .65; }

  @media (max-width: 700px) {
    .map-layout { grid-template-columns: 1fr; }
    .map-box { height: 300px; }
  }
</style>
