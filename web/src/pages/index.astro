---
// Startseite DE ('/'). Etappe 2: Hero. Teaser/Intro folgen in Etappe 3/4.
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import home from '../data/home-settings.json';
import appearance from '../data/appearance-settings.json';
const h = home as any;
const ap = appearance as any;
---
<BaseLayout title="Wide & Wild — Travel & Outdoor Photography" lang="de">
  <HomeHero
    hero={h.hero}
    logo={ap.logo}
    showHeroLogo={ap.show_hero_logo !== false}
    showStories={ap.show_stories === true}
    lang="de"
  />
</BaseLayout>
