---
// Startseite DE ('/'). Hero + Intro + Sektion-Köpfe sind LIVE-Inseln (useTina
// startseite) -> im CMS bearbeitbar mit Klick-ins-Feld + Vorschau (Router /).
// Momentaufnahmen/Aktuell/Entdecken-Inhalte weiterhin aus Alben/Reisen/Stories.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHeroLive from '../components/HomeHeroLive.tsx';
import HomeIntroLive from '../components/HomeIntroLive.tsx';
import HomeJournalCards from '../components/HomeJournalCards.astro';
import '../styles/journal.css';
import HomeSectionHead from '../components/HomeSectionHead.tsx';
import HomeMoments from '../components/HomeMoments.tsx';
import EditorialMoments from '../components/editorial/EditorialMoments.tsx';
import HomeLatest from '../components/HomeLatest.astro';
import HomeDiscover from '../components/HomeDiscover.tsx';
import { buildMoments, buildLatest, buildDiscover } from '../lib/home';
import { normalizePath } from '../lib/stories';
import { sortJournalNodes, formatFullDate, journalHeading, journalHasTitle, journalPlainText } from '../lib/journal';
import { photoDisplay, tripTitle, bi } from '../lib/trips';
import home from '../data/home-settings.json';
import appearance from '../data/appearance-settings.json';
import about from '../data/about.json';
import highlights from '../data/highlights.json';
import { client } from '../../tina/__generated__/client';

const h = home as any;
const ap = appearance as any;
const showStories = ap.show_stories === true;
const showJournal = ap.show_journal === true;
const showDiscover = ap.show_discover !== false;
const design = ap.design === 'editorial' ? 'editorial' : 'klassisch';
const lang = 'de';

const stRes = await client.queries.startseite({ relativePath: 'home-settings.json' });
// „Darstellung"-Doc fürs anklickbare Hero-Logo (data-tina-field -> Logo-Feld).
const apRes = await client.queries.darstellung({ relativePath: 'appearance-settings.json' });

const albumMods = import.meta.glob('../data/albums/*.json', { eager: true });
const albums = Object.entries(albumMods).map(([p, m]) => ({ slug: p.split('/').pop()!.replace('.json', ''), data: ((m as any).default || m) }));
const tripMods = import.meta.glob('../data/trips/*.json', { eager: true });
const trips = Object.entries(tripMods).map(([p, m]) => ({ slug: p.split('/').pop()!.replace('.json', ''), data: ((m as any).default || m) }));
const storyEntries = await getCollection('stories');
const stories = storyEntries.map((e) => ({ slug: e.slug, data: e.data }));

const hlImages = (highlights as any).images || [];
const moments = buildMoments(albums, hlImages, lang);
const latest = buildLatest({ stories, trips, albums, lang, showStories, prefix: '' });
const discover = buildDiscover({ albums, trips, highlights: hlImages, lang, prefix: '' });
// Hero-Bild (LCP) vorab laden: gleicher normalizePath wie im <img>, sonst verpufft der Preload.
// Nur fuer Bild/Slideshow (kein Video); leerer Wert -> kein Preload.
const heroData = ((stRes.data as any)?.startseite?.hero) || {};
const heroFirst = heroData.mode === 'image' ? heroData.image
  : (Array.isArray(heroData.slideshow) && heroData.slideshow[0])
    ? (typeof heroData.slideshow[0] === 'string' ? heroData.slideshow[0] : heroData.slideshow[0]?.img)
    : '';
const heroPreload = heroFirst ? normalizePath(heroFirst) : undefined;

// Neuester Journal-Eintrag für die Hero-Kachel + (Editorial) 3 Einträge für Sektion 04.
const heroJournal = showJournal && ap.hero_journal === true;
const isEd = design === 'editorial';
let journalLatest: any = null;
let journalItems: any[] = [];
if (heroJournal || (isEd && showJournal)) {
  const jc = await client.queries.journalConnection();
  const jn = sortJournalNodes(((jc.data.journalConnection?.edges ?? []).map((e: any) => e?.node).filter(Boolean)) as any[]);
  journalLatest = jn[0] ?? null;
  journalItems = jn.slice(0, 3);
}

// --- Editorial-Startseite: Sektionsdaten aus denselben echten Quellen wie klassisch ---
const ab = about as any;
const edPersons = isEd ? (ab.persons || []).map((p: any) => ({
  name: String(p.name || '').split(' ')[0],
  role: p.role_de || '',
  photo: normalizePath(photoDisplay(p.photo)),
  ground: /luft|aerial|drohne|bewegung/i.test(p.role_de || '') ? 'Aus der Luft' : 'Vom Boden',
})) : [];
const edIntro = ab.intro_de || '';
const edStories = isEd ? [
  ...stories.map((s: any) => ({ year: String(s.data.date || '').slice(0, 4), title: s.data.title_de || '', teaser: s.data.excerpt_de || '', href: `/stories/${s.slug}`, date: s.data.date || '' })),
  ...trips.filter((t: any) => !t.data.upcoming && t.data.title).map((t: any) => ({ year: String(t.data.date || '').slice(0, 4), title: tripTitle(t.data, 'de'), teaser: bi(t.data, 'meta', 'de') || '', href: `/trips/${t.slug}`, date: t.data.date || '' })),
].sort((a: any, b: any) => (b.date || '').localeCompare(a.date || '')).slice(0, 5) : [];
const upcomingTrip = trips.find((t: any) => t.data.upcoming && t.data.title);
const edNextTitle = upcomingTrip ? tripTitle(upcomingTrip.data, 'de') : '';
const edNextMeta = upcomingTrip ? (bi(upcomingTrip.data, 'meta', 'de') || '') : '';
const edNextImg = upcomingTrip ? normalizePath(photoDisplay((upcomingTrip.data.stops || []).map((s: any) => s && s.photo).find(Boolean) || '')) : (hlImages[0] ? normalizePath(hlImages[0]) : '');
const edJournal = journalItems.map((j: any) => ({
  date: formatFullDate(j.date, 'de'),
  text: journalHasTitle(j, 'de') ? journalHeading(j, 'de') : journalPlainText(j, 'de', 150),
  href: j._sys ? `/journal/${j._sys.filename}` : '/journal',
}));
---
<BaseLayout title="Wide & Wild — Travel & Outdoor Photography" lang="de" preloadImage={heroPreload} description="Reise- & Outdoor-Fotografie von Alexandra & David — Roadtrips durch wilde Landschaften, mit Karten, Foto-Alben und Geschichten von unterwegs.">
  <HomeHeroLive client:load query={stRes.query} variables={stRes.variables} data={stRes.data} lang="de" logo={ap.logo} showHeroLogo={ap.show_hero_logo !== false} showStories={showStories} logoQuery={apRes.query} logoVariables={apRes.variables} logoData={apRes.data} heroJournal={heroJournal} journalLatest={journalLatest} design={design} />

  {isEd ? (
    <Fragment>
      {/* 01 — Wer wir sind: Wort-Scrub-Headline + zwei Porträt-Tiles (echte „Über uns"-Personen) */}
      <section class="ed-section">
        <div class="ed-section-head" data-reveal>
          <span class="ed-index">01 — Wer wir sind</span>
          <span class="ed-rule"></span>
        </div>
        <h2 class="ed-h2 ed-scrub" data-scrub set:html={edIntro.split(' ').filter(Boolean).map((w: string) => `<span data-word>${w} </span>`).join('')}></h2>
        <div class="ed-duo">
          {edPersons.map((p: any, i: number) => (
            <a class="ed-duo-tile" href="/portfolio" data-reveal data-drift={i === 0 ? 16 : -16}>
              <img src={p.photo} alt={p.name} data-zoom loading="lazy" decoding="async" />
              <span class="ed-collage-vignette" aria-hidden="true"></span>
              <span class="ed-duo-label">
                <span class="ed-duo-kicker">{p.ground}</span>
                <span class="ed-duo-name">{p.name}</span>
                <span class="ed-duo-role">{p.role}</span>
              </span>
            </a>
          ))}
        </div>
      </section>

      {/* 02 — Portfolio: 12-Spalten-Collage + Lightbox */}
      {moments.length > 0 && (
        <section id="portfolio" class="ed-section">
          <div class="ed-section-head" data-reveal>
            <span class="ed-index">02 — Portfolio</span>
            <span class="ed-rule"></span>
            <a class="ed-more" href="/portfolio">Alle Alben →</a>
          </div>
          <h2 class="ed-h2" data-reveal>Momentaufnahmen</h2>
          <EditorialMoments client:load moments={moments} lang="de" />
        </section>
      )}

      {/* 03 — Stories: Parallax-Vollbild „Als Nächstes" + Listenzeilen */}
      {(edNextTitle || edStories.length > 0) && (
        <section id="stories" class="ed-stories">
          <div class="ed-stories-hero">
            <div class="ed-stories-hero-img" data-ed-parallax>{edNextImg && <img src={edNextImg} alt="" decoding="async" />}</div>
            <div class="ed-stories-hero-scrim" aria-hidden="true"></div>
            <div class="ed-stories-hero-content">
              <p class="ed-index" data-reveal>03 — Stories · Als Nächstes</p>
              <a href={upcomingTrip ? `/trips/${upcomingTrip.slug}` : '/stories'} data-reveal><span class="ed-stories-next" data-ed-story-title>{edNextTitle || 'Stories'}</span></a>
              {edNextMeta && <p class="ed-stories-next-meta" data-reveal>{edNextMeta}</p>}
            </div>
          </div>
          <div class="ed-stories-list">
            {edStories.map((s: any) => (
              <a class="ed-story-row" href={s.href} data-reveal>
                <span class="ed-story-year">{s.year}</span>
                <span class="ed-story-mid">
                  <span class="ed-story-title">{s.title}</span>
                  {s.teaser && <span class="ed-story-teaser">{s.teaser}</span>}
                </span>
                <span class="ed-story-arrow">→</span>
              </a>
            ))}
          </div>
        </section>
      )}

      {/* 04 — Journal: 3 Karten */}
      {showJournal && edJournal.length > 0 && (
        <section id="journal" class="ed-section ed-section--journal">
          <div class="ed-section-head" data-reveal>
            <span class="ed-index">04 — Journal</span>
            <span class="ed-rule"></span>
            <a class="ed-more" href="/journal">Zum Journal →</a>
          </div>
          <div class="ed-journal-grid">
            {edJournal.map((j: any, i: number) => (
              <a class="ed-journal-card" href={j.href} data-reveal data-card={i}>
                <span class="ed-journal-date">{j.date}</span>
                <span class="ed-journal-text">{j.text}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </Fragment>
  ) : (
    <Fragment>
      <HomeIntroLive client:load query={stRes.query} variables={stRes.variables} data={stRes.data} lang="de" />

      {moments.length > 0 && (
        <section style="padding-top:0;">
          <div class="wrap">
            <HomeSectionHead client:load query={stRes.query} variables={stRes.variables} data={stRes.data} lang="de" sectionKey="gallery" />
            <HomeMoments client:load moments={moments} lang="de" />
          </div>
        </section>
      )}

      {latest.length > 0 && (
        <section style="padding-top:0;">
          <div class="wrap">
            <HomeSectionHead client:load query={stRes.query} variables={stRes.variables} data={stRes.data} lang="de" sectionKey="latest" />
            <HomeLatest cards={latest} />
          </div>
        </section>
      )}

      {showDiscover && discover.length > 0 && (
        <section style="padding-top:0;">
          <div class="wrap">
            <HomeSectionHead client:load query={stRes.query} variables={stRes.variables} data={stRes.data} lang="de" sectionKey="discover" />
            <HomeDiscover client:load pool={discover} />
          </div>
        </section>
      )}

      {showJournal && <HomeJournalCards lang="de" prefix="" />}
    </Fragment>
  )}
</BaseLayout>
