---
// Startseite DE ('/'). Hero + Intro + Sektion-Köpfe sind LIVE-Inseln (useTina
// startseite) -> im CMS bearbeitbar mit Klick-ins-Feld + Vorschau (Router /).
// Momentaufnahmen/Aktuell/Entdecken-Inhalte weiterhin aus Alben/Reisen/Stories.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHeroLive from '../components/HomeHeroLive.tsx';
import HomeIntroLive from '../components/HomeIntroLive.tsx';
import HomeJournalCards from '../components/HomeJournalCards.astro';
import '../styles/journal.css';
import HomeSectionHead from '../components/HomeSectionHead.tsx';
import HomeMoments from '../components/HomeMoments.tsx';
import HomeLatest from '../components/HomeLatest.astro';
import HomeDiscover from '../components/HomeDiscover.tsx';
import { buildMoments, buildLatest, buildDiscover } from '../lib/home';
import { normalizePath } from '../lib/stories';
import { sortJournalNodes } from '../lib/journal';
import home from '../data/home-settings.json';
import appearance from '../data/appearance-settings.json';
import highlights from '../data/highlights.json';
import { client } from '../../tina/__generated__/client';

const h = home as any;
const ap = appearance as any;
const showStories = ap.show_stories === true;
const showJournal = ap.show_journal === true;
const showDiscover = ap.show_discover !== false;
const lang = 'de';

const stRes = await client.queries.startseite({ relativePath: 'home-settings.json' });
// „Darstellung"-Doc fürs anklickbare Hero-Logo (data-tina-field -> Logo-Feld).
const apRes = await client.queries.darstellung({ relativePath: 'appearance-settings.json' });

const albumMods = import.meta.glob('../data/albums/*.json', { eager: true });
const albums = Object.entries(albumMods).map(([p, m]) => ({ slug: p.split('/').pop()!.replace('.json', ''), data: ((m as any).default || m) }));
const tripMods = import.meta.glob('../data/trips/*.json', { eager: true });
const trips = Object.entries(tripMods).map(([p, m]) => ({ slug: p.split('/').pop()!.replace('.json', ''), data: ((m as any).default || m) }));
const storyEntries = await getCollection('stories');
const stories = storyEntries.map((e) => ({ slug: e.slug, data: e.data }));

const hlImages = (highlights as any).images || [];
const moments = buildMoments(albums, hlImages, lang);
const latest = buildLatest({ stories, trips, albums, lang, showStories, prefix: '' });
const discover = buildDiscover({ albums, trips, highlights: hlImages, lang, prefix: '' });
// Hero-Bild (LCP) vorab laden: gleicher normalizePath wie im <img>, sonst verpufft der Preload.
// Nur fuer Bild/Slideshow (kein Video); leerer Wert -> kein Preload.
const heroData = ((stRes.data as any)?.startseite?.hero) || {};
const heroFirst = heroData.mode === 'image' ? heroData.image
  : (Array.isArray(heroData.slideshow) && heroData.slideshow[0])
    ? (typeof heroData.slideshow[0] === 'string' ? heroData.slideshow[0] : heroData.slideshow[0]?.img)
    : '';
const heroPreload = heroFirst ? normalizePath(heroFirst) : undefined;

// Neuester Journal-Eintrag für die Hero-Kachel (nur wenn Journal + Hero-Schalter an).
const heroJournal = showJournal && ap.hero_journal === true;
let journalLatest: any = null;
if (heroJournal) {
  const jc = await client.queries.journalConnection();
  const jn = sortJournalNodes(((jc.data.journalConnection?.edges ?? []).map((e: any) => e?.node).filter(Boolean)) as any[]);
  journalLatest = jn[0] ?? null;
}
---
<BaseLayout title="Wide & Wild — Travel & Outdoor Photography" lang="de" preloadImage={heroPreload} description="Reise- & Outdoor-Fotografie von Alexandra & David — Roadtrips durch wilde Landschaften, mit Karten, Foto-Alben und Geschichten von unterwegs.">
  <HomeHeroLive client:load query={stRes.query} variables={stRes.variables} data={stRes.data} lang="de" logo={ap.logo} showHeroLogo={ap.show_hero_logo !== false} showStories={showStories} logoQuery={apRes.query} logoVariables={apRes.variables} logoData={apRes.data} heroJournal={heroJournal} journalLatest={journalLatest} />

  <HomeIntroLive client:load query={stRes.query} variables={stRes.variables} data={stRes.data} lang="de" />

  {moments.length > 0 && (
    <section style="padding-top:0;">
      <div class="wrap">
        <HomeSectionHead client:load query={stRes.query} variables={stRes.variables} data={stRes.data} lang="de" sectionKey="gallery" />
        <HomeMoments client:load moments={moments} lang="de" />
      </div>
    </section>
  )}

  {latest.length > 0 && (
    <section style="padding-top:0;">
      <div class="wrap">
        <HomeSectionHead client:load query={stRes.query} variables={stRes.variables} data={stRes.data} lang="de" sectionKey="latest" />
        <HomeLatest cards={latest} />
      </div>
    </section>
  )}

  {showDiscover && discover.length > 0 && (
    <section style="padding-top:0;">
      <div class="wrap">
        <HomeSectionHead client:load query={stRes.query} variables={stRes.variables} data={stRes.data} lang="de" sectionKey="discover" />
        <HomeDiscover client:load pool={discover} />
      </div>
    </section>
  )}

  {showJournal && <HomeJournalCards lang="de" prefix="" />}
</BaseLayout>
