---
// PROTOTYP-Seite (isoliert): Lightbox + Filmstreifen, der heikelste Teil.
// Echtes Album (content/albums/2024-erste-fotos.json -> src/data/album-proto.json).
import BaseLayout from '../layouts/BaseLayout.astro';
import ProtoGallery from '../components/ProtoGallery.tsx';
import album from '../data/album-proto.json';

const photos = (album.photos || []).map((src: string) => ({ photo: src }));
---
<BaseLayout title="Prototyp · Lightbox + Filmstreifen — Wide & Wild">
  <section>
    <div class="wrap">
      <div class="page-title">
        <div class="kicker">Prototyp (isoliert)</div>
        <h1>Lightbox + Filmstreifen</h1>
        <p>Echtes Album „{album.name_de}", {photos.length} Fotos. Klick auf ein Bild → Lightbox.
           Filmstreifen unten: wischen/Pfeile/Marker. 1:1-Test gegen die Live-Seite.</p>
      </div>
      <ProtoGallery client:load photos={photos} albumName={album.name_de} />
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Thumbnail-Raster (nur Prototyp) */
  .proto-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .proto-cell { aspect-ratio: 1; border: 1px solid var(--c-line); border-radius: var(--radius-sm); background-size: cover; background-position: center; background-color: #2a241c; cursor: pointer; padding: 0; transition: transform var(--dur-base) var(--ease); }
  .proto-cell:hover { transform: scale(1.02); }
  @media (max-width: 640px) { .proto-grid { grid-template-columns: repeat(2, 1fr); } }

  /* Lightbox-CSS liegt jetzt global in src/styles/global.css (genutzt von Reisen,
     Galerie, Stories) — hier bewusst entfernt, um Duplikate zu vermeiden. */
</style>
