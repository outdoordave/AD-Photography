---
// Startseiten-Teaser fürs Journal — schmaler Stream der letzten Einträge, direkt unter
// dem Hero (vor dem Intro). Nur gerendert, wenn im CMS „Journal zeigen?" an ist (Gating
// in index.astro) UND Einträge existieren. Statisch via Tina-Client.
import { client } from '../../tina/__generated__/client';
import RichText from './RichText';
import { sortJournalNodes, journalHeading, journalHasTitle, formatFullDate, journalText } from '../lib/journal';

interface Props { lang: 'de' | 'en'; prefix?: string }
const { lang, prefix = '' } = Astro.props;

const conn = await client.queries.journalConnection();
const nodes = sortJournalNodes((conn.data.journalConnection?.edges ?? []).map((e: any) => e?.node).filter(Boolean) as any[]).slice(0, 4);
const t = lang === 'en'
  ? { kicker: 'Latest', title: 'Journal', all: 'To the journal →' }
  : { kicker: 'Aktuell', title: 'Journal', all: 'Zum Journal →' };
---
{nodes.length > 0 && (
  <section class="home-journal" style="padding-top:0;">
    <div class="wrap">
      <div class="section-head">
        <div class="kicker">{t.kicker}</div>
        <h2>{t.title}</h2>
      </div>
      <ol class="home-journal-list">
        {nodes.map((j: any) => {
          const slug = j._sys.filename;
          const text = journalText(j, lang);
          return (
            <li class="hj-item">
              <a class="hj-head" href={`${prefix}/journal/${slug}`}>
                <span class="hj-title">{journalHeading(j, lang)}</span>
                {journalHasTitle(j, lang) ? <span class="hj-date">{formatFullDate(j.date || '', lang)}</span> : null}
              </a>
              {text ? <div class="hj-text ww-rich"><RichText value={text} /></div> : null}
            </li>
          );
        })}
      </ol>
      <a class="hj-all" href={`${prefix}/journal`}>{t.all}</a>
    </div>
  </section>
)}
