---
// Admin-Werkzeuge, die als Overlay ÜBER einem Kärtchen sitzen (nicht im Karten-<a> verschachtelt).
// Nur sichtbar, wenn im CMS angemeldet (ww-admin-only → SiteNav-Script blendet ein) und beim Hovern.
// Etappe 2: nur „Bearbeiten" (öffnet den Eintrag im CMS-Editor via Tina-Route, target=_top, damit es
// auch aus der Vorschau das ganze Fenster öffnet). Archivieren/Löschen folgen in Etappe 3.
interface Props { collection: string; slug: string; title?: string }
const { collection, slug, title = '' } = Astro.props;
const editHref = `/admin/index.html#/collections/edit/${collection}/~/${slug}`;
const label = title ? `„${title}" bearbeiten` : 'Bearbeiten';
---
<div class="ww-admin-only ww-card-tools" hidden>
  <a class="ww-ct-btn" href={editHref} target="_top" aria-label={label} title="Bearbeiten">
    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 20h9"></path>
      <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path>
    </svg>
  </a>
</div>
