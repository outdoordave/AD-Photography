---
// Globale Navigation (1:1 aus index.html <header><nav>): Sticky Header, Logo→Home,
// 7 Links (aktiver markiert), DE/EN-Umschalter (echte /en-Routen statt JS), Burger
// (mobil). Stories-Link nur wenn showStories. In BaseLayout auf jeder Seite.
interface Props {
  lang: 'de' | 'en';
  pathname: string;
  logo?: string;
  showStories?: boolean;
  showContact?: boolean;
}
const { lang, pathname, logo = '', showStories = false, showContact = true } = Astro.props;

const NAV = [
  { key: 'home', de: 'Start', en: 'Home', href: '/' },
  { key: 'portfolio', de: 'Portfolio', en: 'Portfolio', href: '/portfolio' },
  { key: 'stories', de: 'Stories', en: 'Stories', href: '/stories', storiesOnly: true },
  { key: 'trips', de: 'Reisen', en: 'Trips', href: '/trips' },
  { key: 'gear', de: 'Equipment', en: 'Gear', href: '/gear' },
  { key: 'about', de: 'Über uns', en: 'About', href: '/about' },
  { key: 'contact', de: 'Kontakt', en: 'Contact', href: '/contact', contactOnly: true },
];

const isEn = lang === 'en';
// Pfad ohne trailing Slash; '/en'-Präfix abtrennen -> „bare" Pfad (sprachneutral).
const path = pathname.replace(/\/+$/, '') || '/';
const bare = isEn ? (path.replace(/^\/en/, '') || '/') : path;
const section = bare === '/' ? 'home' : '/' + bare.split('/')[1];

// Ziel der DE/EN-Knöpfe: dieselbe Seite in der anderen Sprache.
const deHref = bare;
const enHref = bare === '/' ? '/en/' : '/en' + bare;

const prefix = isEn ? '/en' : '';
const linkHref = (href: string) => (href === '/' ? (isEn ? '/en/' : '/') : prefix + href);
const isActive = (item: (typeof NAV)[number]) =>
  item.key === 'home' ? section === 'home' : item.href === section;
const logoSrc = logo && logo.charAt(0) !== '/' && !/^https?:/.test(logo) ? '/' + logo : logo;
---
<header>
  <nav class="nav">
    <a class="nav-logo" href={isEn ? '/en/' : '/'} aria-label="Wide & Wild — Start">
      {logoSrc ? <img src={logoSrc} alt="Wide & Wild Logo" /> : <strong>Wide &amp; Wild</strong>}
    </a>
    <div class="nav-links" id="navLinks">
      {NAV.filter((i) => (!i.storiesOnly || showStories) && (!i.contactOnly || showContact)).map((i) => (
        <a href={linkHref(i.href)} class={isActive(i) ? 'active' : ''}>{isEn ? i.en : i.de}</a>
      ))}
      <a href={linkHref('/statistik')} class={`ww-admin-only${section === '/statistik' ? ' active' : ''}`} hidden>📊 Statistik</a>
      <div class="lang-toggle">
        <a href={deHref} class={!isEn ? 'active' : ''}>DE</a>
        <a href={enHref} class={isEn ? 'active' : ''}>EN</a>
      </div>
    </div>
    <button class="burger" id="burger" aria-label="Menü" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </nav>
</header>

<script>
  // Admin-only Links (z. B. 📊 Statistik) nur einblenden, wenn im Tina-CMS angemeldet
  // (gleiche Token-Erkennung wie die Admin-Leiste). Besucher sehen sie nie.
  (function () {
    // Im Tina-CMS-Vorschau-Iframe die Nav waagerecht halten (das schmale Vorschau-Fenster
    // <860px zeigt sonst die mobile Burger-Nav -> Seitenwechsel nur übers Burger). Nur im
    // Iframe -> Live-Seite (oberstes Fenster) und Besucher bleiben 1:1 unberührt.
    try { if (window.self !== window.top) document.documentElement.classList.add('ww-cms-preview'); }
    catch (e) { document.documentElement.classList.add('ww-cms-preview'); }

    function loggedIn() {
      try {
        for (let i = 0; i < localStorage.length; i++) {
          const k = localStorage.key(i);
          if (k && /tina/i.test(k) && (localStorage.getItem(k) || '').length > 20) return true;
        }
      } catch (e) {}
      return false;
    }
    if (loggedIn()) {
      document.querySelectorAll('.ww-admin-only').forEach((el) => { el.hidden = false; });
    }
  })();

  const burger = document.getElementById('burger');
  const links = document.getElementById('navLinks');
  burger?.addEventListener('click', () => {
    const open = links?.classList.toggle('open');
    burger.classList.toggle('open', !!open);
    burger.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  function closeMenu() {
    links?.classList.remove('open');
    burger?.classList.remove('open');
    burger?.setAttribute('aria-expanded', 'false');
  }
  links?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
  // Geöffnetes Burger-Menü schließen, wenn man daneben (außerhalb) klickt/tippt.
  document.addEventListener('click', (e) => {
    if (!links || !links.classList.contains('open')) return;
    const t = e.target as Node;
    if (links.contains(t) || (burger && burger.contains(t))) return;
    closeMenu();
  });
  // Auch mit ESC schließen.
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });
</script>
