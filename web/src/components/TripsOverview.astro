---
// Reisen-Übersicht: ruhige Karten-Liste (eine Karte pro Reise) -> Klick auf die
// Reise-Detailseite /trips/<slug> (bzw. /en/trips/<slug>). Ersetzt die alten Reise-Tabs.
import { tripTitle, bi, tripCover, type RawTrip } from '../lib/trips';
import { groupByYear } from '../lib/groupByYear';
import { richToPlain } from './RichText';
import AdminDocTools from './AdminDocTools.tsx';
interface Props {
  trips: { slug: string; data: RawTrip }[];
  lang: 'de' | 'en';
}
const { trips, lang } = Astro.props;
const isEn = lang === 'en';
const base = isEn ? '/en/trips/' : '/trips/';
---
{groupByYear(trips, (t) => t.data.date).map((g) => (
  <div class="year-chapter">
    <h2 class="year-head">{g.isArchive ? (isEn ? 'Archive' : 'Archiv') : g.year}</h2>
    <div class="trips-overview">
      {g.items.map((t) => {
        const d = t.data;
    const cover = tripCover(d);
    const title = tripTitle(d, lang);
    const meta = bi(d, 'meta', lang);
    const summaryText = richToPlain(bi(d, 'summary', lang));
    const n = Array.isArray(d.stops) ? d.stops.length : 0;
    const stopWord = isEn ? (n === 1 ? 'stop' : 'stops') : (n === 1 ? 'Station' : 'Stationen');
    return (
      <div class="ww-card-wrap">
      <a class="trip-card" href={base + t.slug}>
        <div class="trip-card-cover ph ww-photo">
          {cover ? <img src={cover} alt={title} loading="lazy" /> : null}
          {d.upcoming ? <span class="trip-card-badge">{isEn ? 'soon ✦' : 'bald ✦'}</span> : null}
        </div>
        <div class="trip-card-body">
          {meta ? <div class="trip-card-eyebrow">{meta}</div> : null}
          <h3 class="trip-card-title">{title}</h3>
          <div class="trip-card-count">{n} {stopWord}</div>
          {summaryText ? <p class="trip-card-sum">{summaryText}</p> : null}
        </div>
      </a>
      <AdminDocTools client:load collection="reisen" relativePath={`${t.slug}.json`} title={title} />
      </div>
        );
      })}
    </div>
  </div>
))}
