---
// Schwebender „Bearbeiten"-Knopf für Detailseiten (Story/Reise/Album/Journal) — nur sichtbar, wenn
// im CMS angemeldet (ww-admin-only). Öffnet den Eintrag im CMS-Editor (Tina-Route, target=_top, damit
// es auch aus der Vorschau das ganze Fenster öffnet). Wiederverwendbar über alle Bereiche.
interface Props { collection: string; slug: string; label?: string }
const { collection, slug, label = 'Bearbeiten' } = Astro.props;
const editHref = `/admin/index.html#/collections/edit/${collection}/~/${slug}`;
---
<a class="ww-admin-only ww-edit-fab" hidden href={editHref} target="_top" aria-label="Diesen Beitrag im CMS bearbeiten">
  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 20h9"></path>
    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path>
  </svg>
  <span>{label}</span>
</a>
