---
// Scroll-Motion für das Editorial-Design (nur bei data-design="editorial" in BaseLayout eingebunden).
// Selektor-basiert, damit es auf JEDER Editorial-Seite generisch greift — Seiten setzen nur die
// data-Attribute an die richtigen Elemente:
//   [data-ed-hero-img]      Hero-Bild-Wrapper (Parallax + Ken-Burns)
//   [data-ed-hero-content]  Hero-Textblock (driftet langsamer hoch + faded)
//   [data-ed-parallax]      Vollflächige Parallax-Ebene (z. B. Stories-Bild)
//   [data-ed-story-title]   Titel, dessen Buchstabenabstand beim Eintritt „einrastet"
//   [data-scrub] + [data-word]  Wort-für-Wort-Einblendung einer Headline
//   [data-reveal]           faded ein/aus beim Scrollen (+ [data-zoom]-Bilder zoomen, [data-card]=Stagger)
//   [data-drift]="n"        langsamer Gegen-Scroll je Kachel (n = Stärke)
// Portiert aus dem Claude-Design-Prototyp; respektiert prefers-reduced-motion.
---
<script>
  (() => {
    const root = document.documentElement;
    if (root.getAttribute('data-design') !== 'editorial') return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const header = document.querySelector('header');

    // --- Reveals (immer an, auch bei reduced-motion — dann ohne Bewegung sichtbar) ---
    const observed = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        const el = e.target as HTMLElement;
        if (e.isIntersecting) {
          if (el.hasAttribute('data-card')) el.style.transitionDelay = (parseInt(el.getAttribute('data-card') || '0') || 0) * 100 + 'ms';
          el.style.opacity = '1';
          el.style.transform = 'none';
          if (el.hasAttribute('data-card')) setTimeout(() => { el.style.transitionDelay = '0ms'; }, 600);
          el.querySelectorAll('[data-zoom]').forEach((img) => { (img as HTMLElement).style.transform = 'scale(1)'; });
        } else if (!reduce) {
          const r = el.getBoundingClientRect();
          const below = r.top > window.innerHeight;
          const above = r.bottom < 0;
          if (below || above) {
            el.style.opacity = '0';
            el.style.transform = el.hasAttribute('data-card')
              ? 'translateY(' + (below ? 18 : -18) + 'px) scale(.965)'
              : 'translateY(' + (below ? 24 : -24) + 'px)';
            el.querySelectorAll('[data-zoom]').forEach((img) => { (img as HTMLElement).style.transform = 'scale(1.07)'; });
          }
        }
      });
    }, { threshold: [0, 0.12] });

    const wireReveals = () => {
      document.querySelectorAll('[data-reveal]').forEach((node) => {
        const el = node as HTMLElement;
        if (observed.has(el)) return;
        const r = el.getBoundingClientRect();
        const inView = r.top < window.innerHeight * 0.95 && r.bottom > 0;
        if (!inView && !reduce) {
          el.style.opacity = '0';
          el.style.transform = el.hasAttribute('data-card') ? 'translateY(18px) scale(.965)' : 'translateY(24px)';
        } else {
          el.querySelectorAll('[data-zoom]').forEach((img) => { (img as HTMLElement).style.transform = 'scale(1)'; });
        }
        el.style.transition = 'opacity .8s ease-out, transform .8s cubic-bezier(.2,.6,.2,1)';
        io.observe(el);
        observed.add(el);
      });
    };
    wireReveals();
    const rewire = setInterval(wireReveals, 600);
    setTimeout(() => clearInterval(rewire), 6000);

    // --- Scroll-getriebene Effekte (Nav-Hintergrund immer; Parallax nur ohne reduced-motion) ---
    const onScroll = () => {
      const y = window.scrollY;
      if (header) header.classList.toggle('ed-nav-solid', y > 40);
      if (reduce) return;
      const vh = window.innerHeight;

      const heroImg = document.querySelector('[data-ed-hero-img]') as HTMLElement | null;
      if (heroImg && y < vh) {
        heroImg.style.transform = 'translateY(' + (y * 0.28) + 'px) scale(1.1)';
        heroImg.style.animation = y > 4 ? 'none' : '';
      }
      const heroContent = document.querySelector('[data-ed-hero-content]') as HTMLElement | null;
      if (heroContent && y < vh) {
        heroContent.style.transform = 'translateY(' + (y * -0.12) + 'px)';
        heroContent.style.opacity = String(Math.max(0, 1 - y / (vh * 0.6)));
      }
      document.querySelectorAll('[data-ed-parallax]').forEach((node) => {
        const par = node as HTMLElement;
        const host = par.parentElement;
        if (!host) return;
        const r = host.getBoundingClientRect();
        const progress = (vh - r.top) / (vh + r.height);
        if (progress > -0.1 && progress < 1.1) par.style.transform = 'translateY(' + ((progress - 0.5) * r.height * 0.24) + 'px)';
      });
      const scrub = document.querySelector('[data-scrub]');
      if (scrub) {
        const r = scrub.getBoundingClientRect();
        const p = Math.max(0, Math.min(1, (vh * 0.88 - r.top) / (vh * 0.62)));
        const words = scrub.querySelectorAll('[data-word]');
        words.forEach((w, i) => { (w as HTMLElement).style.opacity = p >= (i + 0.6) / words.length ? '1' : '.16'; });
      }
      document.querySelectorAll('[data-drift]').forEach((node) => {
        const el = node as HTMLElement;
        const amt = parseFloat(el.getAttribute('data-drift') || '0');
        if (!amt) return;
        const r = el.getBoundingClientRect();
        if (r.bottom < -80 || r.top > vh + 80) return;
        const p = (vh - r.top) / (vh + r.height) - 0.5;
        el.style.translate = '0 ' + (-p * amt * 2).toFixed(1) + 'px';
      });
      const st = document.querySelector('[data-ed-story-title]') as HTMLElement | null;
      if (st) {
        const r = st.getBoundingClientRect();
        const p = Math.max(0, Math.min(1, (vh - r.top) / (vh * 0.5)));
        st.style.letterSpacing = (0.08 - p * 0.07).toFixed(3) + 'em';
        st.style.opacity = String(0.25 + p * 0.75);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // --- Sanftes In-Page-Scrollen für Anker (#…) ---
    document.addEventListener('click', (ev) => {
      const t = ev.target as HTMLElement;
      const a = t.closest && (t.closest('a[href^="#"]') as HTMLAnchorElement | null);
      if (!a) return;
      const id = a.getAttribute('href')!.slice(1);
      const target = id && document.getElementById(id);
      if (!target) return;
      ev.preventDefault();
      const from = window.scrollY;
      const to = target.getBoundingClientRect().top + from - 72;
      const dur = reduce ? 0 : Math.min(1100, 400 + Math.abs(to - from) * 0.18);
      if (!dur) { window.scrollTo(0, to); return; }
      const t0 = performance.now();
      const ease = (x: number) => 1 - Math.pow(1 - x, 3);
      const step = (now: number) => {
        const k = Math.min(1, (now - t0) / dur);
        window.scrollTo(0, from + (to - from) * ease(k));
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  })();
</script>
