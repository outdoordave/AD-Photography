# ── Tina-Cloud-Anbindung ──────────────────────────────────────────────
# VORLAGE ohne echte Werte. Zum Nutzen: diese Datei nach ".env" KOPIEREN
# und die Werte aus app.tina.io eintragen. Die echte ".env" ist per
# .gitignore gesperrt und darf NIE committet werden.
#
# Ohne gesetzte CLIENT_ID/TOKEN laeuft Tina im LOKALEN Modus (Mac, npm run dev).

# Oeffentliche Projekt-ID aus app.tina.io (technisch oeffentlich, kein Geheimnis)
TINA_CLIENT_ID=

# Read-only Token aus app.tina.io — GEHEIM! Nur in .env / Cloudflare, nie ins Repo
TINA_TOKEN=

# Git-Branch, den Tina bearbeitet (fuer den Umbau: astro-umbau)
TINA_BRANCH=astro-umbau
